---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { 
    PRODUCTS, 
    getAlternativeProducts,
    type Product 
} from '../../data/products';
import { getAmazonAffiliateUrl, SITE_CONFIG } from '../../config/site';

export async function getStaticPaths() {
    return PRODUCTS.map((product) => ({
        params: { id: product.id },
        props: { product }
    }));
}

interface Props {
    product: Product;
}

const { product } = Astro.props;
const affiliateUrl = getAmazonAffiliateUrl(product.amazonUrl || product.affiliateUrl || product.asin);
const alternatives = getAlternativeProducts(product.id);

// Calculate price per ml/g if possible
let pricePerUnit = '';
const numMatch = product.size.match(/(\d+)\s*(ml|g|gm)/i);
if (numMatch && product.price > 0) {
    const qty = parseInt(numMatch[1], 10);
    const unit = numMatch[2].toLowerCase().replace('gm', 'g');
    if (qty > 0) {
        const perUnit = (product.price / qty).toFixed(1);
        pricePerUnit = `₹${perUnit} per ${unit}`;
    }
}

// Generate schema data
const productSchema = {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": `${product.brand} ${product.name}`,
    "image": product.image,
    "description": product.whyWeLikeIt,
    "brand": {
        "@type": "Brand",
        "name": product.brand
    },
    "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": product.rating.toString(),
        "reviewCount": product.reviewCount.replace(/[^0-9]/g, '') || "500"
    },
    "offers": {
        "@type": "Offer",
        "priceCurrency": "INR",
        "price": product.price.toString(),
        "availability": product.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
        "url": affiliateUrl
    },
    "review": {
        "@type": "Review",
        "reviewRating": {
            "@type": "Rating",
            "ratingValue": product.oraeSkinScore.toString(),
            "bestRating": "10"
        },
        "author": {
            "@type": "Organization",
            "name": "OraeSkin Editorial Team"
        },
        "publisher": {
            "@type": "Organization",
            "name": "OraeSkin"
        }
    }
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": SITE_CONFIG.url
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Reviews",
            "item": `${SITE_CONFIG.url}/reviews/`
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": `${product.brand} ${product.name}`,
            "item": `${SITE_CONFIG.url}/reviews/${product.id}/`
        }
    ]
};

const faqs = [
    {
        q: `Is ${product.brand} ${product.name} suitable for Indian weather?`,
        a: `Yes. In our formulation analysis, its ${product.texture.toLowerCase()} texture and ${product.finish.toLowerCase()} finish perform reliably in Indian heat and humidity without feeling suffocating or heavy.`
    },
    {
        q: `Does this leave any white cast on deeper Indian skin tones?`,
        a: product.whiteCast === 'Zero' 
            ? `No. This formulation has zero white cast and blends invisibly on Fitzpatrick skin types III through VI.`
            : `It has ${product.whiteCast.toLowerCase()} white cast. On deeper skin tones, give it 60–90 seconds to absorb or blend with a light moisturizer.`
    },
    {
        q: `Who should avoid using ${product.brand} ${product.name}?`,
        a: product.avoidIf 
            ? `We advise against it if: ${product.avoidIf}`
            : `Individuals with known allergies to ${product.keyActives.join(', ')} should patch-test first.`
    },
    {
        q: `How does the OraeSkin Score differ from Amazon customer reviews?`,
        a: `Amazon ratings (${product.rating}/5 from ${product.reviewCount} users) measure general customer satisfaction and delivery experience. The OraeSkin Score (${product.oraeSkinScore}/10) is our proprietary editorial evaluation weighing active ingredients (25%), skin suitability (20%), scientific evidence (20%), user sentiment (15%), value (10%), and availability (10%).`
    }
];

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": f.a
        }
    }))
};
---

<Layout 
    title={`${product.brand} ${product.name} Review & Formulation Analysis | OraeSkin`}
    description={`In-depth editorial review of ${product.brand} ${product.name}. OraeSkin Score: ${product.oraeSkinScore}/10. Formulation breakdown, texture in Indian humidity, pros, cons, and verified alternatives.`}
>
    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <Header />
    <main style="padding-top: 120px; padding-bottom: 90px;">
        <article class="container review-container">
            <!-- Breadcrumb -->
            <nav class="review-breadcrumbs" aria-label="Breadcrumb">
                <a href="/">Home</a>
                <span class="sep">/</span>
                <a href="/reviews/">Reviews</a>
                <span class="sep">/</span>
                <a href={`/category/${product.category}/`}>{product.category.replace('-', ' ')}</a>
                <span class="sep">/</span>
                <span class="curr">{product.brand}</span>
            </nav>

            <!-- Review Hero Section -->
            <header class="review-header">
                <div class="review-category-badge">{product.category.toUpperCase()} EDITORIAL REVIEW</div>
                <h1 class="review-title">{product.brand} — {product.name}</h1>
                <p class="review-subtitle">Evidence-informed formulation analysis, texture evaluation for Indian climates, and value assessment.</p>
                
                <div class="review-audit-strip">
                    <span>📅 Last Editorial Review: <strong>{product.lastEditorialReview}</strong></span>
                    <span class="sep-dot">•</span>
                    <span>🏷️ Price Checked: <strong>{product.lastPriceChecked}</strong></span>
                    <span class="sep-dot">•</span>
                    <span>🇮🇳 Fitzpatrick Types III–VI Compatible</span>
                </div>
            </header>

            <!-- Scorecard & Overview Grid -->
            <div class="review-hero-grid">
                <!-- Left: Product Media & Meta -->
                <div class="hero-media-box">
                    <div class="product-img-frame">
                        <img src={product.image} alt={`${product.brand} ${product.name}`} width="260" height="260" />
                    </div>

                    <div class="price-box">
                        <div class="price-val">₹{product.price}</div>
                        <div class="price-meta">
                            <span>Size: {product.size}</span>
                            {pricePerUnit && <span class="unit-price">({pricePerUnit})</span>}
                        </div>
                    </div>

                    <div class="affiliate-action-box">
                        <a 
                            href={affiliateUrl} 
                            target="_blank" 
                            rel="nofollow sponsored noopener" 
                            class="btn-primary-amazon"
                        >
                            <span>Check Price on Amazon →</span>
                        </a>
                        <p class="affiliate-disclosure-note">
                            Affiliate link · We may earn a commission at no extra cost to you.
                        </p>
                    </div>
                </div>

                <!-- Right: Dual Scorecard & Editorial Verdict -->
                <div class="hero-score-box">
                    <!-- Proprietary OraeSkin Score vs Marketplace Rating -->
                    <div class="dual-rating-banner">
                        <div class="score-column oraeskin-score-col">
                            <span class="score-badge-title">OraeSkin Editorial Score</span>
                            <div class="big-score">
                                <span class="score-num">{product.oraeSkinScore.toFixed(1)}</span>
                                <span class="score-denom">/10</span>
                            </div>
                            <span class="score-rating-stars">★★★★★</span>
                            <span class="score-desc">Weighted formulation & climate audit</span>
                        </div>

                        <div class="score-column amazon-rating-col">
                            <span class="score-badge-title">Amazon Customer Rating</span>
                            <div class="big-score">
                                <span class="score-num">{product.rating.toFixed(1)}</span>
                                <span class="score-denom">/5</span>
                            </div>
                            <span class="score-rating-stars amazon-stars">★★★★★</span>
                            <span class="score-desc">{product.reviewCount} verified consumer reviews</span>
                        </div>
                    </div>

                    <!-- 6-Factor OraeSkin Breakdown Progress Bars -->
                    <div class="score-breakdown-panel">
                        <h4 class="breakdown-title">
                            <span>6-Pillar Score Breakdown</span>
                            <a href="/how-we-review/" class="methodology-link">Methodology Rubric →</a>
                        </h4>

                        <div class="breakdown-bars">
                            <div class="bar-row">
                                <div class="bar-meta">
                                    <span>Formula & Hero Actives (25%)</span>
                                    <strong>{product.scoreBreakdown.formula}/10</strong>
                                </div>
                                <div class="bar-track">
                                    <div class="bar-fill" style={`width: ${product.scoreBreakdown.formula * 10}%`}></div>
                                </div>
                            </div>

                            <div class="bar-row">
                                <div class="bar-meta">
                                    <span>Skin Suitability & Climate (20%)</span>
                                    <strong>{product.scoreBreakdown.skinSuitability}/10</strong>
                                </div>
                                <div class="bar-track">
                                    <div class="bar-fill" style={`width: ${product.scoreBreakdown.skinSuitability * 10}%`}></div>
                                </div>
                            </div>

                            <div class="bar-row">
                                <div class="bar-meta">
                                    <span>Scientific Evidence Backing (20%)</span>
                                    <strong>{product.scoreBreakdown.evidence}/10</strong>
                                </div>
                                <div class="bar-track">
                                    <div class="bar-fill" style={`width: ${product.scoreBreakdown.evidence * 10}%`}></div>
                                </div>
                            </div>

                            <div class="bar-row">
                                <div class="bar-meta">
                                    <span>Verified Consumer Feedback (15%)</span>
                                    <strong>{product.scoreBreakdown.userFeedback}/10</strong>
                                </div>
                                <div class="bar-track">
                                    <div class="bar-fill" style={`width: ${product.scoreBreakdown.userFeedback * 10}%`}></div>
                                </div>
                            </div>

                            <div class="bar-row">
                                <div class="bar-meta">
                                    <span>Value for Money & Economics (10%)</span>
                                    <strong>{product.scoreBreakdown.value}/10</strong>
                                </div>
                                <div class="bar-track">
                                    <div class="bar-fill" style={`width: ${product.scoreBreakdown.value * 10}%`}></div>
                                </div>
                            </div>

                            <div class="bar-row">
                                <div class="bar-meta">
                                    <span>Availability & Packaging Quality (10%)</span>
                                    <strong>{product.scoreBreakdown.availability}/10</strong>
                                </div>
                                <div class="bar-track">
                                    <div class="bar-fill" style={`width: ${product.scoreBreakdown.availability * 10}%`}></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Verdict -->
                    <div class="quick-verdict-box">
                        <span class="verdict-tag">Editorial Verdict</span>
                        <p>{product.whyWeLikeIt}</p>
                    </div>

                    <!-- Best For / Avoid If -->
                    <div class="suitability-cards">
                        <div class="suitability-card buy-card">
                            <span class="suitability-label green-text">✓ Best Suited For</span>
                            <p>{product.bestFor}</p>
                        </div>
                        <div class="suitability-card avoid-card">
                            <span class="suitability-label red-text">✗ Consider Skipping If</span>
                            <p>{product.avoidIf}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Deep Analysis Body -->
            <div class="review-deep-body">
                <!-- Section 1: Formulation & Actives -->
                <section class="review-section">
                    <h2>1. Active Ingredients & Formulation Analysis</h2>
                    <p>
                        To understand why {product.brand} {product.name} performs the way it does, we audited its full ingredient list (INCI) and active concentrations:
                    </p>

                    <div class="actives-grid">
                        {product.keyActives.map(active => (
                            <div class="active-card">
                                <span class="active-badge">Hero Active</span>
                                <h4>{active}</h4>
                                <p>Evaluated for stability, skin penetration, and barrier compatibility in high-humidity climates.</p>
                            </div>
                        ))}
                    </div>

                    <div class="formulation-check-matrix">
                        <div class="matrix-item">
                            <span class="matrix-title">Fragrance</span>
                            <span class={`matrix-val ${product.fragrance ? 'warn' : 'good'}`}>
                                {product.fragrance ? 'Contains Added Fragrance' : 'Fragrance-Free ✓'}
                            </span>
                        </div>
                        <div class="matrix-item">
                            <span class="matrix-title">Essential Oils</span>
                            <span class={`matrix-val ${product.essentialOils ? 'warn' : 'good'}`}>
                                {product.essentialOils ? 'Contains Essential Oils' : 'Essential-Oil Free ✓'}
                            </span>
                        </div>
                        <div class="matrix-item">
                            <span class="matrix-title">Drying Alcohols</span>
                            <span class={`matrix-val ${product.alcoholFree ? 'good' : 'warn'}`}>
                                {product.alcoholFree ? 'Alcohol-Free ✓' : 'Contains Alcohol'}
                            </span>
                        </div>
                        <div class="matrix-item">
                            <span class="matrix-title">White Cast</span>
                            <span class="matrix-val good">
                                {product.whiteCast}
                            </span>
                        </div>
                    </div>
                </section>

                <!-- Section 2: Indian Climate Performance -->
                <section class="review-section">
                    <h2>2. Indian Climate & Real-World Wearability</h2>
                    <p>
                        Skincare behaves differently when exposed to 35°C Delhi summers, Chennai humidity, or Bengaluru vehicle pollution. Here is how this formulation fares:
                    </p>
                    <div class="climate-eval-card">
                        <div class="climate-stat">
                            <span class="c-label">Texture Feel:</span>
                            <span class="c-val">{product.texture}</span>
                        </div>
                        <div class="climate-stat">
                            <span class="c-label">Finish On Skin:</span>
                            <span class="c-val">{product.finish}</span>
                        </div>
                        <div class="climate-stat">
                            <span class="c-label">White Cast on Melanin:</span>
                            <span class="c-val">{product.whiteCast}</span>
                        </div>
                        <div class="climate-stat">
                            <span class="c-label">Best Seasons:</span>
                            <span class="c-val">Year-round / Summer & Monsoon Friendly</span>
                        </div>
                    </div>
                </section>

                <!-- Section 3: Balanced Pros and Cons -->
                <section class="review-section">
                    <h2>3. Pros & Important Limitations</h2>
                    <div class="pros-cons-matrix">
                        <div class="pro-panel">
                            <h3>✓ What We Appreciate</h3>
                            <ul>
                                {product.pros.map(pro => (
                                    <li>{pro}</li>
                                ))}
                            </ul>
                        </div>
                        <div class="con-panel">
                            <h3>✗ What Could Be Better</h3>
                            <ul>
                                {product.cons.map(con => (
                                    <li>{con}</li>
                                ))}
                            </ul>
                        </div>
                    </div>
                </section>

                <!-- Section 4: Value Economics -->
                <section class="review-section">
                    <h2>4. Value for Money & Daily Cost-Per-Use</h2>
                    <p>
                        At approximately <strong>₹{product.price}</strong> for {product.size} {pricePerUnit ? `(${pricePerUnit})` : ''}, this formulation sits in the <strong>{product.price <= 450 ? 'Budget' : product.price <= 800 ? 'Mid-Range Value' : 'Premium'}</strong> tier of the Indian skincare market.
                    </p>
                    <p>
                        Given standard application amounts (e.g. 1/4 teaspoon for sunscreens, 3-4 drops for serums, pea-sized for moisturizers), a single container should last between <strong>6 to 10 weeks</strong> of daily twice-a-day application.
                    </p>
                </section>

                <!-- Section 5: Alternatives -->
                {alternatives.length > 0 && (
                    <section class="review-section">
                        <h2>5. If You Don't Like This One: Verified Alternatives</h2>
                        <p>Not every product suits every skin type. If {product.brand} {product.name} isn't the right match, consider these peer-evaluated options:</p>

                        <div class="alternatives-grid">
                            {alternatives.map(alt => (
                                <div class="alt-card">
                                    <div class="alt-thumb">
                                        <img src={alt.product.image} alt={`${alt.product.brand} ${alt.product.name}`} width="80" height="80" />
                                    </div>
                                    <div class="alt-info">
                                        <span class="alt-brand">{alt.product.brand}</span>
                                        <h4 class="alt-name">{alt.product.name}</h4>
                                        <div class="alt-score">OraeSkin Score: <strong>{alt.product.oraeSkinScore.toFixed(1)}/10</strong></div>
                                        <p class="alt-best">Best for: {alt.product.bestFor}</p>
                                        <div class="alt-links">
                                            <a href={`/reviews/${alt.product.id}/`} class="alt-review-link">Read Review →</a>
                                            <a 
                                                href={getAmazonAffiliateUrl(alt.product.amazonUrl || alt.product.affiliateUrl || alt.product.asin)} 
                                                target="_blank" 
                                                rel="nofollow sponsored noopener" 
                                                class="alt-buy-link"
                                            >
                                                ₹{alt.product.price} on Amazon
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </section>
                )}

                <!-- Section 6: Frequently Asked Questions -->
                <section class="review-section">
                    <h2>6. Frequently Asked Questions</h2>
                    <div class="faq-list">
                        {faqs.map(faq => (
                            <div class="faq-item">
                                <h3 class="faq-question">{faq.q}</h3>
                                <p class="faq-answer">{faq.a}</p>
                            </div>
                        ))}
                    </div>
                </section>

                <!-- Sticky Bottom Affiliate Bar -->
                <div class="sticky-review-bar">
                    <div class="container sticky-content">
                        <div class="sticky-meta">
                            <span class="sticky-brand">{product.brand}</span>
                            <span class="sticky-title">{product.name}</span>
                        </div>
                        <div class="sticky-score">
                            <span>Score: <strong>{product.oraeSkinScore.toFixed(1)}/10</strong></span>
                            <span class="sticky-price">₹{product.price}</span>
                        </div>
                        <a 
                            href={affiliateUrl} 
                            target="_blank" 
                            rel="nofollow sponsored noopener" 
                            class="sticky-btn"
                        >
                            Check Price on Amazon →
                        </a>
                    </div>
                </div>
            </div>
        </article>
    </main>
    <Footer />
</Layout>

<style>
    .review-container {
        max-width: 940px;
        margin: 0 auto;
    }

    .review-breadcrumbs {
        font-size: 0.86rem;
        color: #888;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
    }

    .review-breadcrumbs a {
        color: #888;
        text-decoration: none;
        text-transform: capitalize;
    }

    .review-breadcrumbs a:hover {
        color: #c87a54;
    }

    .review-breadcrumbs .sep {
        color: #ccc;
    }

    .review-breadcrumbs .curr {
        color: #2c2c2c;
        font-weight: 600;
    }

    .review-header {
        text-align: center;
        margin-bottom: 36px;
    }

    .review-category-badge {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #c87a54;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
    }

    .review-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.6rem;
        line-height: 1.2;
        color: #2c2c2c;
        margin: 0 0 12px 0;
    }

    .review-subtitle {
        font-size: 1.15rem;
        color: #666;
        max-width: 720px;
        margin: 0 auto 16px auto;
        line-height: 1.6;
    }

    .review-audit-strip {
        font-size: 0.85rem;
        color: #777;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .sep-dot {
        color: #ccc;
    }

    .review-hero-grid {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 32px;
        background: #fff;
        border: 1px solid #eee5dd;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 6px 24px rgba(0,0,0,0.03);
        margin-bottom: 50px;
    }

    .hero-media-box {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .product-img-frame {
        width: 100%;
        background: #fdfaf6;
        border: 1px solid #f0eae1;
        border-radius: 12px;
        padding: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
    }

    .product-img-frame img {
        max-width: 100%;
        height: auto;
        object-fit: contain;
    }

    .price-box {
        text-align: center;
        margin-bottom: 16px;
    }

    .price-val {
        font-size: 2rem;
        font-weight: 800;
        color: #2c2c2c;
    }

    .price-meta {
        font-size: 0.88rem;
        color: #777;
        display: flex;
        gap: 6px;
        justify-content: center;
    }

    .unit-price {
        color: #2e7d32;
        font-weight: 600;
    }

    .affiliate-action-box {
        width: 100%;
        text-align: center;
    }

    .btn-primary-amazon {
        display: block;
        width: 100%;
        box-sizing: border-box;
        background: linear-gradient(135deg, #e8863d, #c87a54);
        color: #ffffff !important;
        font-weight: 700;
        font-size: 1rem;
        padding: 14px 20px;
        border-radius: 30px;
        text-decoration: none;
        box-shadow: 0 6px 18px rgba(200, 122, 84, 0.35);
        transition: all 0.25s ease;
    }

    .btn-primary-amazon:hover {
        background: linear-gradient(135deg, #d3732b, #b3633d);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(200, 122, 84, 0.45);
    }

    .affiliate-disclosure-note {
        font-size: 0.76rem;
        color: #888;
        margin-top: 8px;
        line-height: 1.4;
    }

    /* Dual Rating Banner */
    .dual-rating-banner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 24px;
    }

    .score-column {
        border-radius: 12px;
        padding: 16px;
        text-align: center;
    }

    .oraeskin-score-col {
        background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
        color: #fff;
    }

    .amazon-rating-col {
        background: #fdfaf6;
        border: 1px solid #f0e6dc;
        color: #2c2c2c;
    }

    .score-badge-title {
        display: block;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .oraeskin-score-col .score-badge-title {
        color: #d1bba4;
    }

    .amazon-rating-col .score-badge-title {
        color: #c87a54;
    }

    .big-score {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 2px;
    }

    .score-num {
        font-size: 2.2rem;
        font-weight: 800;
