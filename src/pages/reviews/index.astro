---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { PRODUCTS } from '../../data/products';
import { getAmazonAffiliateUrl } from '../../config/site';

// Sort products by OraeSkin Score descending
const sortedProducts = [...PRODUCTS].sort((a, b) => b.oraeSkinScore - a.oraeSkinScore);

const categories = [
    { id: 'all', name: 'All Products' },
    { id: 'sunscreens', name: 'Sunscreens' },
    { id: 'cleansers', name: 'Cleansers' },
    { id: 'serums', name: 'Serums' },
    { id: 'moisturizers', name: 'Moisturizers' },
    { id: 'toners', name: 'Toners' },
    { id: 'eye-care', name: 'Eye Care' },
    { id: 'lip-care', name: 'Lip Care' },
    { id: 'body-care', name: 'Body Care' },
    { id: 'spot-treatments', name: 'Spot Treatments' },
    { id: 'anti-aging', name: 'Anti-Aging' }
];
---

<Layout 
    title="Product Reviews & Formulation Analysis | OraeSkin"
    description="Browse all 36 in-depth skincare product reviews evaluated with our proprietary OraeSkin Score. Formulations analyzed for Indian skin types, climate, and budgets."
>
    <Header />
    <main style="padding-top: 130px; padding-bottom: 90px;">
        <div class="container reviews-catalog-container">
            <header class="catalog-header">
                <span class="eyebrow">Evidence-Informed Audits</span>
                <h1>Skincare Reviews & Formulation Intelligence</h1>
                <p class="subtitle">Every product is independently researched, formulation-audited, and climate-evaluated. Discover top-performing formulas ranked by our proprietary OraeSkin Score.</p>
                
                <div class="methodology-banner">
                    <div class="banner-left">
                        <strong>⚖️ Transparent Scoring:</strong>
                        <span>Formula (25%) + Climate Suitability (20%) + Evidence (20%) + Consumer Feedback (15%) + Value (10%) + Availability (10%).</span>
                    </div>
                    <a href="/how-we-review/" class="banner-link">Read Methodology →</a>
                </div>

                <!-- Category Filters -->
                <div class="category-filter-pills" id="categoryFilter">
                    {categories.map((cat, idx) => (
                        <button 
                            class={`filter-pill ${idx === 0 ? 'active' : ''}`}
                            data-category={cat.id}
                        >
                            {cat.name}
                        </button>
                    ))}
                </div>
            </header>

            <!-- Product Grid -->
            <div class="products-catalog-grid" id="productsGrid">
                {sortedProducts.map((p) => (
                    <article class="review-catalog-card" data-category={p.category}>
                        <div class="card-thumb">
                            <img src={p.image} alt={`${p.brand} ${p.name}`} loading="lazy" width="160" height="160" />
                            <div class="score-badge">
                                <span class="score-label">OraeSkin</span>
                                <span class="score-value">{p.oraeSkinScore.toFixed(1)}</span>
                            </div>
                        </div>

                        <div class="card-content">
                            <div class="card-meta">
                                <span class="card-brand">{p.brand}</span>
                                <span class="card-category">{p.category.replace('-', ' ')}</span>
                            </div>

                            <h3 class="card-title">
                                <a href={`/reviews/${p.id}/`}>{p.name}</a>
                            </h3>

                            <div class="card-ratings">
                                <span class="stars">★★★★★</span>
                                <span class="amazon-text">{p.rating}/5 on Amazon ({p.reviewCount})</span>
                            </div>

                            <div class="card-best-for">
                                <span class="bf-label">Best For:</span>
                                <span class="bf-val">{p.bestFor}</span>
                            </div>

                            <div class="card-actives">
                                {p.keyActives.map((act) => (
                                    <span class="active-tag">{act}</span>
                                ))}
                            </div>

                            <div class="card-bottom">
                                <div class="card-price">
                                    <span class="price-num">₹{p.price}</span>
                                    <span class="price-size">{p.size}</span>
                                </div>

                                <div class="card-actions">
                                    <a href={`/reviews/${p.id}/`} class="btn-read-review">
                                        Read Review →
                                    </a>
                                    <a 
                                        href={getAmazonAffiliateUrl(p.amazonUrl || p.affiliateUrl || p.asin)} 
                                        target="_blank" 
                                        rel="nofollow sponsored noopener" 
                                        class="btn-amazon-pill"
                                        title="Check Price on Amazon"
                                    >
                                        Amazon
                                    </a>
                                </div>
                            </div>
                        </div>
                    </article>
                ))}
            </div>

            <!-- Empty State -->
            <div id="noProductsFound" class="empty-state" style="display: none;">
                <p>No products found in this category yet. Check back soon as our editorial database expands!</p>
            </div>
        </div>
    </main>
    <Footer />
</Layout>

<script>
    const filterButtons = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('.review-catalog-card');
    const emptyState = document.getElementById('noProductsFound');

    filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            filterButtons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const category = btn.getAttribute('data-category');
            let visibleCount = 0;

            cards.forEach(card => {
                const cardCategory = card.getAttribute('data-category');
                if (category === 'all' || cardCategory === category) {
                    (card as HTMLElement).style.display = 'flex';
                    visibleCount++;
                } else {
                    (card as HTMLElement).style.display = 'none';
                }
            });

            if (emptyState) {
                emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
            }
        });
    });
</script>

<style>
    .reviews-catalog-container {
        max-width: 1180px;
        margin: 0 auto;
    }

    .catalog-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .eyebrow {
        display: inline-block;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #c87a54;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
    }

    .catalog-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: 2.6rem;
        color: #2c2c2c;
        margin: 0 0 14px 0;
    }

    .subtitle {
        font-size: 1.15rem;
        color: #666;
        max-width: 760px;
        margin: 0 auto 24px auto;
        line-height: 1.6;
    }

    .methodology-banner {
        background: #fdfaf6;
        border: 1px solid #ebd9cb;
        border-radius: 12px;
        padding: 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        max-width: 820px;
        margin: 0 auto 30px auto;
        text-align: left;
    }

    .banner-left {
        font-size: 0.88rem;
        color: #555;
    }

    .banner-left strong {
        color: #c87a54;
        display: inline-block;
        margin-right: 4px;
    }

    .banner-link {
        font-size: 0.88rem;
        font-weight: 700;
        color: #c87a54;
        text-decoration: underline;
        white-space: nowrap;
    }

    .category-filter-pills {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 10px;
    }

    .filter-pill {
        background: #fff;
        border: 1px solid #e3d5c7;
        color: #555;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .filter-pill:hover {
        background: #faf4ed;
        border-color: #c87a54;
        color: #c87a54;
    }

    .filter-pill.active {
        background: #2c2c2c;
        border-color: #2c2c2c;
        color: #fff;
    }

    .products-catalog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
        gap: 26px;
    }

    .review-catalog-card {
        background: #fff;
        border: 1px solid #eee5dd;
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .review-catalog-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    }

    .card-thumb {
        position: relative;
        background: #fdfaf6;
        padding: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 180px;
        border-bottom: 1px solid #f0eae1;
    }

    .card-thumb img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    .score-badge {
        position: absolute;
        bottom: 12px;
        right: 12px;
        background: #2c2c2c;
        color: #fff;
        border-radius: 8px;
        padding: 4px 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    .score-label {
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #d1bba4;
    }

    .score-value {
        font-size: 1.15rem;
        font-weight: 800;
        color: #f7a87b;
        line-height: 1;
    }

    .card-content {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .card-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 6px;
    }

    .card-brand {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #c87a54;
        letter-spacing: 1px;
    }

    .card-category {
        font-size: 0.75rem;
        color: #888;
        text-transform: capitalize;
    }

    .card-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.25rem;
        line-height: 1.35;
        margin: 0 0 8px 0;
    }

    .card-title a {
        color: #2c2c2c;
        text-decoration: none;
    }

    .card-title a:hover {
        color: #c87a54;
    }

    .card-ratings {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.84rem;
        margin-bottom: 10px;
    }

    .stars {
        color: #f59e0b;
        letter-spacing: 1px;
    }

    .amazon-text {
        color: #777;
    }

    .card-best-for {
        font-size: 0.84rem;
        background: #fdfaf6;
        padding: 6px 10px;
        border-radius: 6px;
        margin-bottom: 12px;
        line-height: 1.4;
    }

    .bf-label {
        font-weight: 700;
        color: #4a3e36;
    }

    .bf-val {
        color: #6a5a4e;
    }

    .card-actives {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-bottom: 18px;
    }

    .active-tag {
        background: #f2ede6;
        color: #555;
        font-size: 0.74rem;
        padding: 2px 8px;
        border-radius: 10px;
        font-weight: 500;
    }

    .card-bottom {
        margin-top: auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #f2ede6;
        padding-top: 14px;
    }

    .card-price {
        display: flex;
        flex-direction: column;
    }

    .price-num {
        font-size: 1.25rem;
        font-weight: 800;
        color: #2c2c2c;
        line-height: 1;
    }

    .price-size {
        font-size: 0.75rem;
        color: #888;
    }

    .card-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-read-review {
        font-size: 0.84rem;
        font-weight: 700;
        color: #c87a54;
        text-decoration: underline;
    }

    .btn-amazon-pill {
        background: #f7ede4;
        color: #c87a54;
        border: 1px solid #ebd9cb;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-amazon-pill:hover {
        background: #c87a54;
        color: #fff;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #777;
        font-size: 1.1rem;
    }

    @media (max-width: 768px) {
        .catalog-header h1 {
            font-size: 2.2rem;
        }
        .products-catalog-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
