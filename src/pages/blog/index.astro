---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AffiliateDisclaimer from '../../components/AffiliateDisclaimer.astro';
import CategoryNav from '../../components/CategoryNav.astro';

// Dynamically load all markdown articles
const rawPosts = import.meta.glob('./*.md', { eager: true });

const articles = Object.entries(rawPosts).map(([filePath, post]: [string, any]) => {
    const slug = filePath.replace(/^\.\//, '').replace(/\.md$/, '');
    return {
        title: post.frontmatter?.title || 'Skincare Review',
        url: `/blog/${slug}`,
        image: post.frontmatter?.image || '/images/products/minimalist-spf50.jpg',
        category: post.frontmatter?.category || 'Skincare',
        rating: post.frontmatter?.rating || 4.8,
        date: post.frontmatter?.date || 'March 2026',
        description: post.frontmatter?.description || 'Evidence-informed product review and Amazon India buying guide.'
    };
}).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const totalArticles = articles.length;
---

<Layout title={`Skincare Reviews & Buying Guides (${totalArticles}+ Tested Guides) | OraeSkin`}>
    <meta name="description" content={`Explore ${totalArticles}+ in-depth skincare buying guides, product comparisons, and curated Amazon India recommendations for Indian skin.`} slot="head" />
    <meta name="keywords" content="skincare reviews india, amazon india skincare deals, best sunscreen india, facewash for oily skin, oraeskin" slot="head" />
    
	<Header />
	<main class="blog-main-page">
        <div class="container">
            <header class="blog-hero-header">
                <span class="eyebrow">Editorial & Laboratory ({totalArticles} Published Guides)</span>
                <h1>Skincare Reviews & Buying Guides</h1>
                <p class="subtitle">
                    Independent clinical evaluations, ingredient safety breakdowns, and verified Amazon India deals tested for Indian climate conditions.
                </p>
                <AffiliateDisclaimer compact={true} />

                <!-- Category Nav -->
                <div style="margin-top: 2rem;">
                    <CategoryNav activeSlug="all" />
                </div>

                <!-- Live Search Box -->
                <div class="search-filter-box">
                    <div class="search-input-wrapper">
                        <svg width="18" height="18" viewBox="0 0 20 20" fill="#94a3b8">
                            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/>
                        </svg>
                        <input 
                            type="text" 
                            id="article-search-input" 
                            placeholder="Search by ingredient, concern, or product (e.g., Niacinamide, Acne, SPF, Retinol)..." 
                            aria-label="Search articles"
                        />
                    </div>
                    <div class="search-count-badge" id="search-count-badge">
                        Showing all {totalArticles} articles
                    </div>
                </div>
            </header>

            <!-- Concern Filter Anchors -->
            <div id="concern-anchors" style="position: relative; height: 0; overflow: hidden;" aria-hidden="true">
                <span id="acne"></span>
                <span id="sun"></span>
                <span id="oily"></span>
                <span id="pigmentation"></span>
                <span id="dry"></span>
                <span id="glow"></span>
            </div>

            <!-- Articles Grid -->
            <div class="articles-grid" id="articles-grid">
                {articles.map((post) => (
                    <article 
                        class="article-card" 
                        data-title={post.title.toLowerCase()} 
                        data-category={post.category.toLowerCase()}
                        data-desc={post.description.toLowerCase()}
                    >
                        <a href={post.url} class="card-img-link">
                            <img src={post.image} alt={post.title} loading="lazy" decoding="async" />
                            <span class="card-category-badge">{post.category}</span>
                        </a>
                        <div class="card-body">
                            <div class="card-meta">
                                <span class="card-rating">★ {post.rating}</span>
                                <span class="meta-dot">•</span>
                                <span class="card-date">{post.date}</span>
                            </div>
                            <h3>
                                <a href={post.url}>{post.title}</a>
                            </h3>
                            <p>{post.description}</p>
                            <div class="card-footer">
                                <a href={post.url} class="card-action-btn">Read Buying Guide →</a>
                            </div>
                        </div>
                    </article>
                ))}
            </div>

            <!-- Empty Search State -->
            <div id="no-results-box" class="no-results-box" style="display: none;">
                <p>No guides found matching your search term. Try searching for "sunscreen", "cleanser", "retinol", or "pigmentation".</p>
            </div>
        </div>
	</main>
	<Footer />
</Layout>

<script is:inline>
(function() {
    const searchInput = document.getElementById('article-search-input');
    const badge = document.getElementById('search-count-badge');
    const cards = document.querySelectorAll('.article-card');
    const noResults = document.getElementById('no-results-box');

    if (!searchInput) return;

    searchInput.addEventListener('input', function(e) {
        const query = e.target.value.trim().toLowerCase();
        let visibleCount = 0;

        cards.forEach(card => {
            const title = card.getAttribute('data-title') || '';
            const cat = card.getAttribute('data-category') || '';
            const desc = card.getAttribute('data-desc') || '';

            if (!query || title.includes(query) || cat.includes(query) || desc.includes(query)) {
                card.style.display = 'flex';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        if (badge) {
            badge.textContent = `Showing ${visibleCount} of ${cards.length} articles`;
        }

        if (noResults) {
            noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
    });

    // Auto-filter if a hash tag (e.g. #acne, #sun, #oily) is present in URL
    function applyHashFilter() {
        if (window.location.hash) {
            const rawHash = window.location.hash.replace(/^#/, '').trim().toLowerCase();
            if (rawHash) {
                searchInput.value = rawHash;
                searchInput.dispatchEvent(new Event('input'));
            }
        }
    }

    applyHashFilter();
    window.addEventListener('hashchange', applyHashFilter);
})();
</script>

<style>
    .blog-main-page {
        padding-top: 120px;
        padding-bottom: 90px;
        background: #fdfaf6;
    }

    .blog-hero-header {
        text-align: center;
        max-width: 820px;
        margin: 0 auto 40px auto;
    }

    .eyebrow {
        display: inline-block;
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #c87a54;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
    }

    .blog-hero-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: 2.6rem;
        color: #2c2c2c;
        margin: 0 0 12px 0;
    }

    .subtitle {
        color: #666;
        font-size: 1.05rem;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .search-filter-box {
        margin-top: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
    }

    .search-input-wrapper {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: #ffffff;
        border: 2px solid rgba(212, 163, 115, 0.3);
        border-radius: 9999px;
        padding: 0.75rem 1.5rem;
        width: 100%;
        max-width: 600px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .search-input-wrapper:focus-within {
        border-color: #b07d4b;
        box-shadow: 0 6px 20px rgba(212, 163, 115, 0.25);
    }

    .search-input-wrapper input {
        border: none;
        outline: none;
        font-size: 0.95rem;
        width: 100%;
        color: #1e293b;
        background: transparent;
    }

    .search-count-badge {
        font-size: 0.85rem;
        font-weight: 600;
        color: #64748b;
    }

    .articles-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
        gap: 32px;
        margin-top: 2rem;
    }

    .article-card {
        background: #ffffff;
        border: 1px solid #ede5da;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.03);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        display: flex;
        flex-direction: column;
    }

    .article-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
    }

    .card-img-link {
        display: block;
        position: relative;
        height: 220px;
        overflow: hidden;
        background: #fcf8f2;
    }

    .card-img-link img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .article-card:hover .card-img-link img {
        transform: scale(1.03);
    }

    .card-category-badge {
        position: absolute;
        bottom: 12px;
        left: 12px;
        background: rgba(255, 255, 255, 0.95);
        color: #c87a54;
        font-weight: 700;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 4px 10px;
        border-radius: 8px;
    }

    .card-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .card-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.82rem;
        color: #888;
        margin-bottom: 10px;
    }

    .card-rating {
        color: #f59e0b;
        font-weight: 700;
    }

    .meta-dot {
        color: #ccc;
    }

    .card-body h3 {
        font-family: 'Playfair Display', serif;
        font-size: 1.25rem;
        line-height: 1.35;
        margin: 0 0 12px 0;
    }

    .card-body h3 a {
        color: #2c2c2c;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .card-body h3 a:hover {
        color: #c87a54;
    }

    .card-body p {
        color: #666;
        font-size: 0.92rem;
        line-height: 1.55;
        margin: 0 0 20px 0;
        flex: 1;
    }

    .card-footer {
        border-top: 1px solid #f0eae1;
        padding-top: 14px;
    }

    .card-action-btn {
        color: #c87a54;
        font-weight: 700;
        font-size: 0.92rem;
        text-decoration: none;
        transition: transform 0.2s ease;
        display: inline-block;
    }

    .card-action-btn:hover {
        transform: translateX(4px);
        color: #a85d38;
    }

    .no-results-box {
        text-align: center;
        padding: 4rem 1rem;
        color: #64748b;
        font-size: 1.1rem;
    }

    @media (max-width: 768px) {
        .blog-hero-header h1 {
            font-size: 2.1rem;
        }

        .articles-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
