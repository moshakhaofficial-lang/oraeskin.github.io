---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AffiliateDisclaimer from '../../components/AffiliateDisclaimer.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import ProductCard from '../../components/ProductCard.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import { CATEGORIES } from '../../data/categories';
import { PRODUCTS } from '../../data/products';

export function getStaticPaths() {
    return CATEGORIES.map((cat) => ({
        params: { category: cat.slug },
        props: { category: cat }
    }));
}

const { category } = Astro.props;

// Filter products for this category
const categoryProducts = PRODUCTS.filter(p => p.category === category.slug);

// Comparison items formatted for ComparisonTable component
const comparisonProducts = categoryProducts.map(p => ({
    name: p.title,
    brand: p.brand,
    badge: p.badge,
    rating: p.rating,
    bestFor: p.badge || p.concerns[0] || 'Daily Care',
    price: p.priceEst,
    asinOrUrl: p.asin,
    image: p.image
}));
---

<Layout title={`${category.name} Reviews & Buying Guide (India) | OraeSkin`}>
    <Header />

    <main class="category-page-main">
        <!-- Hero Section -->
        <header class="category-hero">
            <div class="container hero-container">
                <div class="hero-icon-badge">{category.icon}</div>
                <h1 class="hero-title">{category.name}</h1>
                <p class="hero-tagline">{category.tagline}</p>
                <p class="hero-description">{category.description}</p>

                <!-- Key Actives Bar -->
                <div class="actives-bar">
                    <span class="actives-label">Key Dermatological Actives:</span>
                    <div class="actives-pills">
                        {category.topActives.map(active => (
                            <span class="active-pill">{active}</span>
                        ))}
                    </div>
                </div>

                <div class="hero-meta-bar">
                    <span class="meta-item">
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                        Independently Tested for Indian Skin
                    </span>
                    <span class="meta-item">
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                        Amazon India Verified Best-Sellers
                    </span>
                </div>
            </div>
        </header>

        <!-- Category Nav -->
        <div class="container nav-section-container">
            <CategoryNav activeSlug={category.slug} />
            <AffiliateDisclaimer compact={true} />
        </div>

        <!-- Comparison Table Section (if multiple items) -->
        {comparisonProducts.length > 1 && (
            <section class="container comparison-section">
                <div class="section-heading-group">
                    <span class="section-tag">Quick Comparison Matrix</span>
                    <h2 class="section-heading">Compare Top {category.name} at a Glance</h2>
                    <p class="section-sub">Side-by-side breakdown of formulation purity, skin type suitability, and Amazon availability.</p>
                </div>
                <ComparisonTable 
                    title={`${category.name} Spec Comparison`} 
                    products={comparisonProducts} 
                />
            </section>
        )}

        <!-- In-Depth Product Reviews -->
        <section class="container products-section">
            <div class="section-heading-group">
                <span class="section-tag">Tested & Ranked</span>
                <h2 class="section-heading">Detailed Reviews: The Best {category.name} in India</h2>
                <p class="section-sub">Comprehensive editorial scorecards based on texture, humidity resistance, and ingredient efficacy.</p>
            </div>

            <div class="product-cards-stack">
                {categoryProducts.map((p, idx) => (
                    <ProductCard
                        rank={idx + 1}
                        title={p.title}
                        brand={p.brand}
                        badge={p.badge}
                        rating={p.rating}
                        reviewCount={p.reviewCount}
                        priceEstimate={p.priceEst}
                        asinOrUrl={p.asin}
                        image={p.image}
                        bestFor={p.badge}
                        keyIngredients={p.keyIngredients}
                        pros={p.pros}
                        cons={p.cons}
                    />
                ))}
            </div>
        </section>

        <!-- Indian Buyer's Guide & FAQ -->
        <section class="container guide-section">
            <div class="guide-box">
                <h3 class="guide-title">How to Choose the Right {category.name} for Indian Weather</h3>
                <div class="guide-content">
                    <p>
                        In India's tropical and subtropical climate, choosing {category.name.toLowerCase()} requires accounting for high humidity, sweat, strong UV radiation, and environmental pollution.
                    </p>
                    <ul>
                        <li><strong>Match Formula to Season</strong>: In hot humid monsoons, choose lightweight, oil-free gel or water-burst textures that absorb without leaving a suffocating film. During cooler winter months, opt for barrier-replenishing ceramide formulas.</li>
                        <li><strong>Check Active Stability</strong>: Certain active ingredients (such as raw L-Ascorbic Acid) degrade quickly in Indian ambient heat. We recommend stabilized derivatives like Ethyl Ascorbic Acid, encapsulated Retinol, and photostable UV filters.</li>
                        <li><strong>Patch Test Before Full Application</strong>: When introducing potent actives, always patch test on the jawline or inner forearm for 24 hours to monitor for sensitivity.</li>
                    </ul>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    .category-page-main {
        padding-top: 90px;
        padding-bottom: 90px;
        background: #fbfbfa;
    }

    .category-hero {
        background: linear-gradient(180deg, #f4eee7 0%, #fbfbfa 100%);
        padding: 4rem 1rem 3rem;
        text-align: center;
        border-bottom: 1px solid rgba(212, 163, 115, 0.2);
    }

    .hero-container {
        max-width: 800px;
        margin: 0 auto;
    }

    .hero-icon-badge {
        font-size: 2.75rem;
        margin-bottom: 0.75rem;
    }

    .hero-title {
        font-family: 'Cinzel', serif;
        font-size: 2.75rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 0.75rem 0;
        line-height: 1.2;
    }

    .hero-tagline {
        font-size: 1.2rem;
        font-weight: 600;
        color: #b07d4b;
        margin: 0 0 1rem 0;
    }

    .hero-description {
        font-size: 1.05rem;
        color: #64748b;
        line-height: 1.65;
        margin: 0 0 1.75rem 0;
    }

    .actives-bar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

    .actives-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: #475569;
    }

    .actives-pills {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .active-pill {
        font-size: 0.8rem;
        font-weight: 600;
        background: rgba(212, 163, 115, 0.15);
        color: #92400e;
        padding: 0.25rem 0.65rem;
        border-radius: 9999px;
    }

    .hero-meta-bar {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        flex-wrap: wrap;
        font-size: 0.85rem;
        color: #64748b;
        font-weight: 500;
    }

    .meta-item {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .meta-item svg {
        color: #16a34a;
    }

    .nav-section-container {
        margin-top: 1.5rem;
        margin-bottom: 2rem;
    }

    .section-heading-group {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .section-tag {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #b07d4b;
        background: rgba(212, 163, 115, 0.15);
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        margin-bottom: 0.5rem;
    }

    .section-heading {
        font-family: 'Cinzel', serif;
        font-size: 2rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 0.5rem 0;
    }

    .section-sub {
        font-size: 1rem;
        color: #64748b;
        margin: 0;
    }

    .comparison-section {
        margin: 3.5rem auto;
    }

    .products-section {
        margin: 4rem auto;
    }

    .product-cards-stack {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .guide-section {
        margin: 4rem auto;
    }

    .guide-box {
        background: #ffffff;
        border: 1px solid rgba(44, 53, 64, 0.1);
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    }

    .guide-title {
        font-family: 'Cinzel', serif;
        font-size: 1.5rem;
        color: #1e293b;
        margin: 0 0 1rem 0;
    }

    .guide-content {
        font-size: 1rem;
        line-height: 1.7;
        color: #475569;
    }

    .guide-content ul {
        margin-top: 1rem;
        padding-left: 1.5rem;
    }

    .guide-content li {
        margin-bottom: 0.75rem;
    }

    @media (max-width: 640px) {
        .hero-title {
            font-size: 2rem;
        }
        .section-heading {
            font-size: 1.6rem;
        }
        .guide-box {
            padding: 1.5rem;
        }
    }
</style>
