---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConcernFilter from '../components/ConcernFilter.astro';
import TopPicks from '../components/TopPicks.astro';
import AffiliateDisclaimer from '../components/AffiliateDisclaimer.astro';
import RoutineFinder from '../components/RoutineFinder.astro';
import CategoryNav from '../components/CategoryNav.astro';
---

<Layout title="OraeSkin | India's Trusted Skincare Reviews, Buying Guides & Amazon Deals">
	<Header />
	<main>
		<!-- Editorial Hero Section -->
		<section class="editorial-hero">
			<div class="container hero-grid">
				<div class="hero-text-content">
					<div class="hero-tag-badge">
						<span class="live-dot"></span>
						<span>Independent Indian Skincare Editorial • 2026</span>
					</div>
					<h1 class="hero-headline">
						Research. Compare. <span class="gradient-text">Choose Better Skincare</span> for Indian Skin.
					</h1>
					<p class="hero-subtext">
						Evidence-informed skincare recommendations built specifically for Indian skin, tropical climates, and accessible budgets. We analyze active formulations, weather textures, and customer sentiment to help you buy with confidence.
					</p>

					<!-- Quick Search / Trend Pills -->
					<div class="trend-pills">
						<span class="trend-label">Trending Now:</span>
						<a href="/blog/best-sunscreens-for-indian-skin" class="pill">☀️ Zero-Cast Sunscreens</a>
						<a href="/comparisons/minimalist-spf50-vs-dermaco-hyaluronic-sunscreen/" class="pill">⚖️ Minimalist vs Derma Co</a>
						<a href="/reviews/cerave-foaming-cleanser/" class="pill">🫧 CeraVe Cleanser Review</a>
						<a href="/how-we-review/" class="pill">📋 Scoring Methodology</a>
					</div>

					<div class="hero-actions">
						<a href="#routine-finder" class="btn-hero-primary">
							<span>Find My Routine →</span>
						</a>
						<a href="/reviews/" class="btn-hero-secondary">Explore Best Products</a>
						<a href="/comparisons/" class="btn-hero-outline">Compare Products</a>
					</div>
				</div>

				<div class="hero-feature-card">
					<div class="feature-card-inner">
						<div class="card-badge">Featured Buying Guide</div>
						<div class="feature-img-box">
							<img src="/images/products/minimalist-spf50.jpg" alt="7 Best Sunscreens for Indian Skin" loading="eager" />
						</div>
						<div class="feature-card-content">
							<span class="card-cat">Sun Protection • Top 7 Evaluated</span>
							<h3>Best Sunscreens for Indian Skin (Zero White Cast & Sweat-Proof)</h3>
							<p>We analyzed 25+ top sunscreens on Amazon India to find formulas that melt invisibly into melanin-rich skin.</p>
							<a href="/blog/best-sunscreens-for-indian-skin" class="btn-read-guide">
								Read Full Guide & Deals →
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Trust & Methodology Strip -->
		<section class="trust-strip-section">
			<div class="container">
				<div class="trust-strip-grid">
					<div class="trust-strip-item">
						<span class="trust-icon">🔬</span>
						<div class="trust-info">
							<strong>Formulation Analysis</strong>
							<span>Declared active concentrations & INCI purity</span>
						</div>
					</div>
					<div class="trust-strip-item">
						<span class="trust-icon">⚖️</span>
						<div class="trust-info">
							<strong>OraeSkin Score</strong>
							<span>6-pillar objective editorial scoring system</span>
						</div>
					</div>
					<div class="trust-strip-item">
						<span class="trust-icon">🇮🇳</span>
						<div class="trust-info">
							<strong>Indian Climate Ready</strong>
							<span>Monsoon humidity, sweat resilience & zero cast</span>
						</div>
					</div>
					<div class="trust-strip-item">
						<span class="trust-icon">🛡️</span>
						<div class="trust-info">
							<strong>Zero Sponsored Rankings</strong>
							<span>Brands cannot buy placement or favorable scores</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Skincare Category Navigation Bar -->
		<div class="container category-nav-container">
			<CategoryNav />
		</div>

		<!-- Interactive 30-Second Routine Finder Quiz -->
		<RoutineFinder />

		<!-- Head-to-Head Comparisons Feature Section -->
		<section class="home-comparisons-section">
			<div class="container">
				<div class="section-header-center">
					<span class="eyebrow">Product Showdowns</span>
					<h2>Popular Skincare Comparisons</h2>
					<p>Torn between two bestsellers? We break down the formulations, textures, and value-for-money to pick the right one for your skin.</p>
				</div>

				<div class="home-comp-grid">
					<a href="/comparisons/minimalist-spf50-vs-dermaco-hyaluronic-sunscreen/" class="home-comp-card">
						<span class="h-comp-badge">Sunscreens</span>
						<h4>Minimalist SPF 50 vs The Derma Co 1% Hyaluronic</h4>
						<p>Certified photostability vs ultra-lightweight aqua gel in Indian humidity.</p>
						<span class="h-comp-link">Compare Now →</span>
					</a>

					<a href="/comparisons/cerave-foaming-vs-cetaphil-gentle-cleanser/" class="home-comp-card">
						<span class="h-comp-badge">Cleansers</span>
						<h4>CeraVe Foaming Cleanser vs Cetaphil Gentle Cleanser</h4>
						<p>3 Essential Ceramides gel foam vs soap-free non-foaming lotion for reactive skin.</p>
						<span class="h-comp-link">Compare Now →</span>
					</a>

					<a href="/comparisons/minimalist-10-vitc-vs-plum-15-vitc/" class="home-comp-card">
						<span class="h-comp-badge">Serums</span>
						<h4>Minimalist 10% Vitamin C vs Plum 15% Vitamin C Mandarin</h4>
						<p>Ethyl Ascorbic Acid + Centella vs Japanese Mandarin glow booster for dark spots.</p>
						<span class="h-comp-link">Compare Now →</span>
					</a>
				</div>

				<div class="comp-all-btn-row">
					<a href="/comparisons/" class="btn-all-comparisons">Browse All Head-to-Head Comparisons →</a>
				</div>
			</div>
		</section>

		<!-- Skin Concerns Filter Grid -->
		<ConcernFilter />

		<!-- Editor's Choice Amazon India Top Picks -->
		<TopPicks />

		<!-- Best-in-Class Buying Guides & Reviews -->
		<section id="guides" class="guides-section">
			<div class="container">
				<div class="section-header-center">
					<span class="eyebrow">Expert Buying Guides</span>
					<h2>Latest Skincare Reviews & Comparisons</h2>
					<p>In-depth product breakdowns, ingredient analysis, and price comparisons across Amazon India.</p>
				</div>

				<div class="guides-grid">
					<!-- Guide 1 -->
					<article class="guide-card">
						<div class="guide-card-img">
							<img src="/images/products/minimalist-spf50.jpg" alt="7 Best Sunscreens for Indian Skin" loading="lazy" />
							<span class="guide-badge">Sunscreen</span>
						</div>
						<div class="guide-card-body">
							<div class="guide-meta">
								<span>★ 4.9 Rating</span>
								<span>•</span>
								<span>March 2026</span>
							</div>
							<h3><a href="/blog/best-sunscreens-for-indian-skin">7 Best Sunscreens for Indian Skin (Zero White Cast & Sweat-Proof on Amazon India)</a></h3>
							<p>Say goodbye to ghostly purple cast and greasy residue. Explore our dermatologist-vetted top SPF 50 picks.</p>
							<div class="guide-footer">
								<a href="/blog/best-sunscreens-for-indian-skin" class="guide-link">Read Buying Guide →</a>
							</div>
						</div>
					</article>

					<!-- Guide 2 -->
					<article class="guide-card">
						<div class="guide-card-img">
							<img src="/images/products/cerave-cleanser.jpg" alt="Best Facewashes for Acne & Oily Skin" loading="lazy" />
							<span class="guide-badge">Cleansers</span>
						</div>
						<div class="guide-card-body">
							<div class="guide-meta">
								<span>★ 4.8 Rating</span>
								<span>•</span>
								<span>March 2026</span>
							</div>
							<h3><a href="/blog/best-cleansers-acne-oily-skin">Top 6 Facewashes for Acne & Oily Skin in India (Amazon India Tested)</a></h3>
							<p>Gentle salicylic acid and foaming cleansers that unclog stubborn pores without ruining your moisture barrier.</p>
							<div class="guide-footer">
								<a href="/blog/best-cleansers-acne-oily-skin" class="guide-link">Read Buying Guide →</a>
							</div>
						</div>
					</article>

					<!-- Guide 3 -->
					<article class="guide-card">
						<div class="guide-card-img">
							<img src="/images/products/dotkey-rice-cream.jpg" alt="Rice Water & Ceramide Benefits" loading="lazy" />
							<span class="guide-badge">Moisturizers</span>
						</div>
						<div class="guide-card-body">
							<div class="guide-meta">
								<span>★ 4.7 Rating</span>
								<span>•</span>
								<span>Skincare Science</span>
							</div>
							<h3><a href="/blog/rice-water-vitamin-e-benefits">Rice Water & Ceramide Moisturizer: The Secret to Indian Glass Skin</a></h3>
							<p>How fermented rice water and ceramides rebuild weakened skin barriers and brighten post-acne dark marks.</p>
							<div class="guide-footer">
								<a href="/blog/rice-water-vitamin-e-benefits" class="guide-link">Read Article →</a>
							</div>
						</div>
					</article>

					<!-- Guide 4 -->
					<article class="guide-card">
						<div class="guide-card-img">
							<img src="/images/products/avocado-night-cream.jpg" alt="Avocado Cream Benefits" loading="lazy" />
							<span class="guide-badge">Barrier Care</span>
						</div>
						<div class="guide-card-body">
							<div class="guide-meta">
								<span>★ 4.8 Rating</span>
								<span>•</span>
								<span>Deep Nourishment</span>
							</div>
							<h3><a href="/blog/avocado-cream-benefits">Avocado Cream for Skin: Deep Hydration & Anti-Aging Routine</a></h3>
							<p>Cold-pressed avocado oil and essential fatty acids for restoring youthful bounce and repairing rough, dry skin.</p>
							<div class="guide-footer">
								<a href="/blog/avocado-cream-benefits" class="guide-link">Read Article →</a>
							</div>
						</div>
					</article>

					<!-- Guide 5: Vitamin C -->
					<article class="guide-card">
						<div class="guide-card-img">
							<img src="/images/products/minimalist-spf50.jpg" alt="Best Vitamin C Serums for Indian Skin" loading="lazy" />
							<span class="guide-badge">Serums & Actives</span>
						</div>
						<div class="guide-card-body">
							<div class="guide-meta">
								<span>★ 4.8 Rating</span>
								<span>•</span>
								<span>March 2026</span>
							</div>
							<h3><a href="/blog/best-vitamin-c-serums-for-indian-skin">Best Vitamin C Serums for Indian Skin: Fading Dark Spots & Hyperpigmentation</a></h3>
							<p>Thermal stability tests in Indian heat: Ethyl Ascorbic Acid vs L-Ascorbic Acid for stubborn melanin spots.</p>
							<div class="guide-footer">
								<a href="/blog/best-vitamin-c-serums-for-indian-skin" class="guide-link">Read Buying Guide →</a>
							</div>
						</div>
					</article>

					<!-- Guide 6: Barrier Repair -->
					<article class="guide-card">
						<div class="guide-card-img">
							<img src="/images/products/dotkey-rice-cream.jpg" alt="Best Barrier Repair Creams" loading="lazy" />
							<span class="guide-badge">Moisturizers</span>
						</div>
						<div class="guide-card-body">
							<div class="guide-meta">
								<span>★ 4.8 Rating</span>
								<span>•</span>
								<span>March 2026</span>
							</div>
							<h3><a href="/blog/best-barrier-repair-creams-india">Best Barrier Repair & Ceramide Creams in India for Damaged Skin</a></h3>
							<p>Heal over-exfoliated stinging skin, eliminate dry flaking, and restore your lipid matrix in 7 days.</p>
							<div class="guide-footer">
								<a href="/blog/best-barrier-repair-creams-india" class="guide-link">Read Buying Guide →</a>
							</div>
						</div>
					</article>

					<!-- Guide 7: Under-Eye Dark Circles -->
					<article class="guide-card">
						<div class="guide-card-img">
							<img src="/images/products/cerave-cleanser.jpg" alt="Best Under-Eye Creams" loading="lazy" />
							<span class="guide-badge">Eye Care</span>
						</div>
						<div class="guide-card-body">
							<div class="guide-meta">
								<span>★ 4.7 Rating</span>
								<span>•</span>
								<span>March 2026</span>
							</div>
							<h3><a href="/blog/best-under-eye-creams-dark-circles">Best Under-Eye Creams for Dark Circles & Puffy Eyes in India</a></h3>
							<p>Ophthalmologist-tested formulas with 5% caffeine, peptides, and ceramides for hereditary dark circles.</p>
							<div class="guide-footer">
								<a href="/blog/best-under-eye-creams-dark-circles" class="guide-link">Read Buying Guide →</a>
							</div>
						</div>
					</article>

					<!-- Guide 8: Exfoliating Toners -->
					<article class="guide-card">
						<div class="guide-card-img">
							<img src="/images/products/cetaphil-cleanser.jpg" alt="Best Exfoliating Toners" loading="lazy" />
							<span class="guide-badge">Toners</span>
						</div>
						<div class="guide-card-body">
							<div class="guide-meta">
								<span>★ 4.7 Rating</span>
								<span>•</span>
								<span>March 2026</span>
							</div>
							<h3><a href="/blog/best-exfoliating-toners-glycolic-salicylic">Best Exfoliating Toners in India for Open Pores & Textured Skin</a></h3>
							<p>AHA Glycolic vs BHA Salicylic: Clear stubborn texture, dissolve blackheads, and fade body tanning safely.</p>
							<div class="guide-footer">
								<a href="/blog/best-exfoliating-toners-glycolic-salicylic" class="guide-link">Read Buying Guide →</a>
							</div>
						</div>
					</article>

					<!-- Guide 9: Facewash Guide -->
					<article class="guide-card">
						<div class="guide-card-img">
							<img src="/images/products/cetaphil-cleanser.jpg" alt="Transformative Power of Facewash" loading="lazy" />
							<span class="guide-badge">Routines</span>
						</div>
						<div class="guide-card-body">
							<div class="guide-meta">
								<span>★ 4.8 Rating</span>
								<span>•</span>
								<span>Routine Guide</span>
							</div>
							<h3><a href="/blog/transformative-power-facewash">The Transformative Power of the Right Facewash</a></h3>
							<p>Master the 60-second rule and double cleansing to eliminate urban pollution and sunscreen buildup.</p>
							<div class="guide-footer">
								<a href="/blog/transformative-power-facewash" class="guide-link">Read Article →</a>
							</div>
						</div>
					</article>
				</div>

				<div class="view-all-guides">
					<a href="/blog" class="btn-view-all">View All Guides & Product Reviews →</a>
				</div>
			</div>
		</section>

		<!-- Ingredient Spotlight Section -->
		<section class="ingredients-spotlight">
			<div class="container">
				<div class="section-header-center">
					<span class="eyebrow">Science & Tradition</span>
					<h2>Key Ingredients That Transform Indian Skin</h2>
					<p>Understand the science behind the actives formulated in today's best skincare products.</p>
				</div>

				<div class="ingredients-grid">
					<div class="ingredient-box">
						<span class="ing-badge">Niacinamide 10%</span>
						<h4>Vitamin B3</h4>
						<p>The ultimate multi-tasker: regulates sebum, strengthens the moisture barrier, and fades stubborn dark spots.</p>
					</div>

					<div class="ingredient-box">
						<span class="ing-badge">Ceramide Complex</span>
						<h4>Lipid Barrier Restorer</h4>
						<p>Skin-identical lipids that lock in hydration, soothe redness, and protect against air conditioning and pollution.</p>
					</div>

					<div class="ingredient-box">
						<span class="ing-badge">Salicylic Acid 2%</span>
						<h4>Beta Hydroxy Acid (BHA)</h4>
						<p>Oil-soluble exfoliant that dives deep into sebaceous follicles to eliminate blackheads, whiteheads, and acne flare-ups.</p>
					</div>

					<div class="ingredient-box">
						<span class="ing-badge">Fermented Rice Water</span>
						<h4>Oryza Sativa Ferment</h4>
						<p>Rich in inositol and amino acids, rice ferment tightens pores, calms irritation, and delivers radiant glass-skin luminosity.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Amazon Skincare Deal Alerts / Trust Callout -->
		<section class="deal-alert-section">
			<div class="container">
				<div class="deal-alert-card">
					<div class="deal-alert-content">
						<span class="deal-pill">Smart Skincare Shopping</span>
						<h2>Never Overpay for Skincare on Amazon India</h2>
						<p>Prices on Amazon fluctuate daily during Great Indian Festival, Prime Day, and super-value sales. We track verified sellers, lightning deals, and price drops so you get genuine products at the lowest price.</p>
						<div class="deal-buttons">
							<a href="#top-picks" class="btn-check-deals">Browse Today's Curated Deals</a>
							<a href="/disclosure" class="btn-read-disclosure">How We Review & Earn</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- In-Page Disclaimer -->
		<div class="container">
			<AffiliateDisclaimer />
		</div>
