---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConcernFilter from '../components/ConcernFilter.astro';
import TopPicks from '../components/TopPicks.astro';
import AffiliateDisclaimer from '../components/AffiliateDisclaimer.astro';
import RoutineFinder from '../components/RoutineFinder.astro';
import CategoryNav from '../components/CategoryNav.astro';
import { getProductById, AVAILABLE_PRODUCTS } from '../data/products';
import { getAmazonAffiliateUrl } from '../config/site';

const heroPick = getProductById('minimalist-spf50');
const heroPickUrl = heroPick ? getAmazonAffiliateUrl(heroPick.asin) : '';

// Guide cards read their title, image and summary from the guides themselves
const posts = import.meta.glob<{ frontmatter: Record<string, any> }>('./blog/*.md', { eager: true });
const guideSlugs = [
    'best-sunscreens-for-indian-skin',
    'best-cleansers-acne-oily-skin',
    'best-vitamin-c-serums-for-indian-skin',
    'best-barrier-repair-creams-india',
    'best-under-eye-creams-dark-circles',
    'best-exfoliating-toners-glycolic-salicylic',
];
const guides = guideSlugs
    .map(slug => ({ slug, fm: posts[`./blog/${slug}.md`]?.frontmatter }))
    .filter(g => g.fm);
const guideCount = Object.keys(posts).length;

const concerns = [
    { id: 'acne', label: 'Acne & pimples' },
    { id: 'pigmentation', label: 'Dark spots' },
    { id: 'oily', label: 'Oily skin & pores' },
    { id: 'dry', label: 'Dry or sensitive' },
    { id: 'sun', label: 'Tan & sun damage' },
    { id: 'glow', label: 'Dullness' },
];
---

<Layout title="OraeSkin | India's Trusted Skincare Reviews, Buying Guides & Amazon Deals">
	<Header />
	<main>
		<!-- Hero: what the site does, the fastest route to a product, and one buyable pick -->
		<section class="editorial-hero">
			<div class="container hero-grid">
				<div class="hero-text-content">
					<span class="hero-tag-badge">Independent reviews for Indian skin</span>
					<h1 class="hero-headline">
						Find skincare that <span class="hl">actually suits</span> your skin.
					</h1>
					<p class="hero-subtext">
						{AVAILABLE_PRODUCTS.length} products scored on formula, climate fit and value, with current Amazon India prices.
					</p>

					<div class="hero-actions">
						<a href="#top-picks" class="btn-hero-primary">See top picks</a>
						<a href="#routine-finder" class="btn-hero-secondary">Build my routine in 30 sec</a>
					</div>

					<div class="concern-chips">
						<span class="chips-label">Shop by concern</span>
						<div class="chips-row">
							{concerns.map(c => <a href={`/blog/#${c.id}`} class="chip">{c.label}</a>)}
						</div>
					</div>
				</div>

				{heroPick && (
					<aside class="hero-pick" aria-label="Editors' number one pick">
						<span class="hp-badge">Editors' #1 pick</span>
						<a href={heroPickUrl} target="_blank" rel="nofollow sponsored noopener" class="hp-img" data-placement="home_hero_image" data-product={heroPick.id} tabindex="-1" aria-hidden="true">
							<img src={heroPick.image} alt="" loading="eager" fetchpriority="high" decoding="async" width="240" height="240" />
						</a>
						<div class="hp-body">
							<span class="hp-brand">{heroPick.brand}</span>
							<h2 class="hp-name">{heroPick.name}</h2>
							<div class="hp-meta">
								<span class="star-meter" style={`--rating: ${heroPick.amazonRating}`} aria-hidden="true"></span>
								<span>{heroPick.amazonRating.toFixed(1)} on Amazon ({heroPick.amazonReviews})</span>
							</div>
							<p class="hp-why">{heroPick.bestFor}</p>
							<a href={heroPickUrl} target="_blank" rel="nofollow sponsored noopener" class="btn-buy block" data-placement="home_hero" data-product={heroPick.id}>
								Check price on Amazon · {heroPick.priceEst}{'\u00a0→'}
							</a>
							<div class="hp-foot">
								<a href={`/reviews/${heroPick.id}/`}>Read our review ({heroPick.oraeSkinScore.toFixed(1)}/10)</a>
								<span>Affiliate link</span>
							</div>
						</div>
					</aside>
				)}
			</div>
		</section>

		<!-- Trust strip -->
		<section class="trust-strip-section">
			<div class="container">
				<ul class="trust-strip-grid">
					<li><strong>{AVAILABLE_PRODUCTS.length} products</strong> scored on 6 factors</li>
					<li><strong>{guideCount} guides</strong> for Indian skin and weather</li>
					<li><strong>Prices re-checked</strong> every month</li>
					<li><strong>No paid rankings</strong>, ever</li>
				</ul>
			</div>
		</section>

		<!-- Shoppable top picks, straight after the hero -->
		<TopPicks />

		<!-- Skincare Category Navigation Bar -->
		<div class="container category-nav-container">
			<CategoryNav />
		</div>

		<!-- Interactive 30-Second Routine Finder Quiz -->
		<RoutineFinder />

		<!-- Head-to-Head Comparisons Feature Section -->
		<section class="home-comparisons-section">
			<div class="container">
				<div class="section-header-center">
					<span class="eyebrow">Product Showdowns</span>
					<h2>Popular Skincare Comparisons</h2>
					<p>Torn between two bestsellers? We break down the formulations, textures, and value-for-money to pick the right one for your skin.</p>
				</div>

				<div class="home-comp-grid">
					<a href="/comparisons/minimalist-spf50-vs-dermaco-hyaluronic-sunscreen/" class="home-comp-card">
						<span class="h-comp-badge">Sunscreens</span>
						<h4>Minimalist SPF 50 vs The Derma Co 1% Hyaluronic</h4>
						<p>Certified photostability vs ultra-lightweight aqua gel in Indian humidity.</p>
						<span class="h-comp-link">Compare Now →</span>
					</a>

					<a href="/comparisons/cerave-foaming-vs-cetaphil-gentle-cleanser/" class="home-comp-card">
						<span class="h-comp-badge">Cleansers</span>
						<h4>CeraVe Foaming Cleanser vs Cetaphil Gentle Cleanser</h4>
						<p>3 Essential Ceramides gel foam vs soap-free non-foaming lotion for reactive skin.</p>
						<span class="h-comp-link">Compare Now →</span>
					</a>

					<a href="/comparisons/minimalist-10-vitc-vs-plum-15-vitc/" class="home-comp-card">
						<span class="h-comp-badge">Serums</span>
						<h4>Minimalist 10% Vitamin C vs Plum 15% Vitamin C Mandarin</h4>
						<p>Ethyl Ascorbic Acid + Centella vs Japanese Mandarin glow booster for dark spots.</p>
						<span class="h-comp-link">Compare Now →</span>
					</a>
				</div>

				<div class="comp-all-btn-row">
					<a href="/comparisons/" class="btn-all-comparisons">Browse All Head-to-Head Comparisons →</a>
				</div>
			</div>
		</section>

		<!-- Skin Concerns Filter Grid -->
		<ConcernFilter />

		<!-- Best-in-Class Buying Guides & Reviews -->
		<section id="guides" class="guides-section">
			<div class="container">
				<div class="section-header-center">
					<span class="eyebrow">Buying guides</span>
					<h2>Most-read buying guides</h2>
					<p>Ranked picks for one need at a time, each with a comparison table and current prices.</p>
				</div>

				<div class="guides-grid">
					{guides.map(({ slug, fm }) => (
						<article class="guide-card">
							<a href={`/blog/${slug}/`} class="guide-card-img" tabindex="-1" aria-hidden="true">
								{fm.image && <img src={fm.image} alt="" loading="lazy" decoding="async" width="400" height="400" />}
								{fm.category && <span class="guide-badge">{fm.category}</span>}
							</a>
							<div class="guide-card-body">
								<h3><a href={`/blog/${slug}/`}>{fm.title}</a></h3>
								<p>{fm.description}</p>
								<a href={`/blog/${slug}/`} class="guide-link">See the picks →</a>
							</div>
						</article>
					))}
				</div>

				<div class="view-all-guides">
					<a href="/blog/" class="btn-view-all">Browse all {guideCount} guides →</a>
				</div>
			</div>
		</section>

		<!-- Ingredient Spotlight Section -->
		<section class="ingredients-spotlight">
			<div class="container">
				<div class="section-header-center">
					<span class="eyebrow">Science & Tradition</span>
					<h2>Key Ingredients That Transform Indian Skin</h2>
					<p>Understand the science behind the actives formulated in today's best skincare products.</p>
				</div>

				<div class="ingredients-grid">
					<div class="ingredient-box">
						<span class="ing-badge">Niacinamide 10%</span>
						<h4>Vitamin B3</h4>
						<p>The ultimate multi-tasker: regulates sebum, strengthens the moisture barrier, and fades stubborn dark spots.</p>
					</div>

					<div class="ingredient-box">
						<span class="ing-badge">Ceramide Complex</span>
						<h4>Lipid Barrier Restorer</h4>
						<p>Skin-identical lipids that lock in hydration, soothe redness, and protect against air conditioning and pollution.</p>
					</div>

					<div class="ingredient-box">
						<span class="ing-badge">Salicylic Acid 2%</span>
						<h4>Beta Hydroxy Acid (BHA)</h4>
						<p>Oil-soluble exfoliant that dives deep into sebaceous follicles to eliminate blackheads, whiteheads, and acne flare-ups.</p>
					</div>

					<div class="ingredient-box">
						<span class="ing-badge">Fermented Rice Water</span>
						<h4>Oryza Sativa Ferment</h4>
						<p>Rich in inositol and amino acids, rice ferment tightens pores, calms irritation, and delivers radiant glass-skin luminosity.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Amazon Skincare Deal Alerts / Trust Callout -->
		<section class="deal-alert-section">
			<div class="container">
				<div class="deal-alert-card">
					<div class="deal-alert-content">
						<span class="deal-pill">Shop smarter</span>
						<h2>Know the fair price before you buy</h2>
						<p>Amazon prices move daily, and more during the Great Indian Festival and Prime Day. We re-check every product's price and rating each month and print the date on every review, so you know what a fair price looks like before you buy.</p>
						<div class="deal-buttons">
							<a href="#top-picks" class="btn-check-deals">See top picks</a>
							<a href="/disclosure/" class="btn-read-disclosure">How We Review & Earn</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- In-Page Disclaimer -->
		<div class="container">
			<AffiliateDisclaimer />
		</div>
	</main>
	<Footer />
</Layout>

<style>
	/* Hero */
	.editorial-hero {
		padding: 120px 0 56px;
		background: linear-gradient(180deg, #fdfbf7 0%, #f8f1e7 100%);
		border-bottom: 1px solid var(--line);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
		gap: 56px;
		align-items: center;
	}

	.hero-tag-badge {
		display: inline-block;
		background: var(--accent-soft);
		color: var(--accent);
		font-size: 0.76rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1px;
		padding: 6px 12px;
		border-radius: 20px;
		margin-bottom: 18px;
	}

	.hero-headline {
		font-family: 'Playfair Display', serif;
		font-size: clamp(2.1rem, 4.6vw, 3.5rem);
		line-height: 1.12;
		letter-spacing: -0.01em;
		color: var(--ink);
		margin: 0 0 16px 0;
		text-wrap: balance;
	}

	.hl {
		color: var(--accent);
		font-style: italic;
	}

	.hero-subtext {
		font-size: 1.1rem;
		line-height: 1.6;
		color: var(--ink-soft);
		margin: 0 0 26px;
		max-width: 520px;
	}

	.hero-actions {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		margin-bottom: 30px;
	}

	.btn-hero-primary,
	.btn-hero-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 50px;
		padding: 12px 26px;
		border-radius: 12px;
		font-weight: 700;
		font-size: 1rem;
		text-decoration: none;
		transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
	}

	.btn-hero-primary {
		background: var(--ink);
		color: #fff;
		border: 1px solid var(--ink);
	}

	.btn-hero-primary:hover {
		background: #3a322c;
	}

	.btn-hero-secondary {
		background: #fff;
		color: var(--ink);
		border: 1px solid #d4c8b8;
	}

	.btn-hero-secondary:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.chips-label {
		display: block;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: var(--ink-mute);
		margin-bottom: 10px;
	}

	.chips-row {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 8px 14px;
		background: #fff;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.chip:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	/* Hero pick card */
	.hero-pick {
		position: relative;
		background: #fff;
		border: 1px solid var(--line);
		border-radius: 20px;
		box-shadow: 0 18px 50px rgba(34, 29, 25, 0.1);
		overflow: hidden;
	}

	.hp-badge {
		position: absolute;
		top: 14px;
		left: 14px;
		z-index: 1;
		padding: 5px 11px;
		background: var(--ink);
		color: #fff;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.6px;
		text-transform: uppercase;
		border-radius: 6px;
	}

	.hp-img {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 210px;
		padding: 18px;
		background: var(--paper);
	}

	.hp-img img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		mix-blend-mode: multiply;
	}

	.hp-body {
		padding: 18px 20px 20px;
	}

	.hp-brand {
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: var(--accent);
	}

	.hp-name {
		font-family: 'Playfair Display', serif;
		font-size: 1.3rem;
		line-height: 1.25;
		color: var(--ink);
		margin: 2px 0 8px;
		text-align: left;
		letter-spacing: 0;
	}

	.hp-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 8px;
		font-size: 0.84rem;
		color: var(--ink-soft);
	}

	.hp-why {
		margin: 10px 0 16px;
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--ink-soft);
	}

	.hp-foot {
		display: flex;
		justify-content: space-between;
		gap: 10px;
		margin-top: 12px;
		font-size: 0.8rem;
		color: var(--ink-mute);
	}

	.hp-foot a {
		color: var(--accent);
		font-weight: 600;
	}

	/* Trust strip */
	.trust-strip-section {
		background: var(--ink);
		padding: 14px 0;
	}

	.trust-strip-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, auto);
		justify-content: space-between;
		gap: 8px 24px;
		font-size: 0.86rem;
		color: #cfc6bb;
	}

	.trust-strip-grid strong {
		color: #fff;
	}

	.category-nav-container {
		margin-top: 8px;
	}

	/* Home Comparisons Section */
	.home-comparisons-section {
		padding: 60px 0;
		background: #fcf9f5;
		border-top: 1px solid #eee5dd;
		border-bottom: 1px solid #eee5dd;
	}

	.home-comp-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 22px;
		margin: 36px 0 28px 0;
	}

	.home-comp-card {
		background: #ffffff;
		border: 1px solid #ede5da;
		border-radius: 14px;
		padding: 24px;
		text-decoration: none;
		display: flex;
		flex-direction: column;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.home-comp-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 25px rgba(0,0,0,0.06);
		border-color: #c87a54;
	}

	.h-comp-badge {
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.8px;
		color: #c87a54;
		margin-bottom: 8px;
	}

	.home-comp-card h4 {
		font-family: 'Playfair Display', serif;
		font-size: 1.18rem;
		color: #2c2c2c;
		margin: 0 0 8px 0;
		line-height: 1.35;
	}

	.home-comp-card p {
		font-size: 0.88rem;
		color: #666;
		line-height: 1.5;
		margin: 0 0 16px 0;
		flex: 1;
	}

	.h-comp-link {
		font-size: 0.85rem;
		font-weight: 700;
		color: #c87a54;
		text-decoration: underline;
	}

	.comp-all-btn-row {
		text-align: center;
		margin-top: 10px;
	}

	.btn-all-comparisons {
		display: inline-block;
		font-size: 0.95rem;
		font-weight: 700;
		color: #2c2c2c;
		text-decoration: none;
		padding: 10px 22px;
		border-radius: 20px;
		border: 1px solid #c87a54;
		transition: all 0.2s ease;
	}

	.btn-all-comparisons:hover {
		background: #c87a54;
		color: #fff;
	}

	/* Hero Featured Card */
	.hero-feature-card {
		background: #ffffff;
		border-radius: 20px;
		padding: 24px;
		border: 1px solid #ede5da;
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.06);
		position: relative;
	}

	.card-badge {
		position: absolute;
		top: 14px;
		left: 14px;
		background: #c87a54;
		color: #fff;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.8px;
		padding: 4px 12px;
		border-radius: 12px;
		z-index: 2;
	}

	.feature-img-box {
		width: 100%;
		height: 220px;
		border-radius: 14px;
		overflow: hidden;
		margin-bottom: 18px;
		background: #fcf8f2;
	}

	.feature-img-box img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card-cat {
		font-size: 0.78rem;
		font-weight: 600;
		color: #c87a54;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.feature-card-content h3 {
		font-family: 'Playfair Display', serif;
		font-size: 1.35rem;
		color: #2c2c2c;
		margin: 8px 0 10px 0;
		line-height: 1.3;
	}

	.feature-card-content p {
		color: #666;
		font-size: 0.92rem;
		line-height: 1.5;
		margin-bottom: 16px;
	}

	.btn-read-guide {
		display: inline-block;
		color: #c87a54;
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
		transition: transform 0.2s ease;
	}

	.btn-read-guide:hover {
		transform: translateX(4px);
		color: #a85d38;
	}

	/* Guides Section */
	.guides-section {
		padding: 80px 0;
		background: #faf6f0;
	}

	.section-header-center {
		text-align: center;
		max-width: 680px;
		margin: 0 auto 48px auto;
	}

	.eyebrow {
		display: inline-block;
		font-size: 0.82rem;
		font-weight: 700;
		text-transform: uppercase;
		color: #c87a54;
		letter-spacing: 1.5px;
		margin-bottom: 8px;
	}

	.section-header-center h2 {
		font-family: 'Playfair Display', serif;
		font-size: 2.3rem;
		color: #2c2c2c;
		margin-bottom: 10px;
	}

	.section-header-center p {
		color: #666;
		font-size: 1.05rem;
		margin: 0;
	}

	.guides-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 28px;
	}

	.guide-card {
		background: #ffffff;
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid #ede5da;
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.04);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
		display: flex;
		flex-direction: column;
	}

	.guide-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 36px rgba(0, 0, 0, 0.08);
	}

	.guide-card-img {
		display: block;
		position: relative;
		height: 180px;
		overflow: hidden;
		background: #fdfaf6;
	}

	.guide-card-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.guide-card:hover .guide-card-img img {
		transform: scale(1.03);
	}

	.guide-badge {
		position: absolute;
