	<Footer />
</Layout>

<style>
	/* Editorial Hero Styles */
	.editorial-hero {
		padding: 130px 0 70px 0;
		background: linear-gradient(180deg, #fdfbf7 0%, #faf5ee 100%);
		border-bottom: 1px solid #ede5da;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 48px;
		align-items: center;
	}

	.hero-tag-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: #f5ede4;
		color: #c87a54;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1px;
		padding: 6px 14px;
		border-radius: 20px;
		margin-bottom: 20px;
	}

	.live-dot {
		width: 8px;
		height: 8px;
		background: #2e7d32;
		border-radius: 50%;
		display: inline-block;
		box-shadow: 0 0 0 3px rgba(46, 125, 50, 0.2);
	}

	.hero-headline {
		font-family: 'Playfair Display', serif;
		font-size: 3.2rem;
		line-height: 1.18;
		color: #242424;
		margin: 0 0 20px 0;
	}

	.gradient-text {
		background: linear-gradient(135deg, #c87a54, #d4af37);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-subtext {
		font-size: 1.12rem;
		line-height: 1.7;
		color: #555555;
		margin-bottom: 26px;
		max-width: 540px;
	}

	.trend-pills {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 32px;
	}

	.trend-label {
		font-size: 0.82rem;
		font-weight: 700;
		color: #888;
		text-transform: uppercase;
	}

	.trend-pills .pill {
		background: #ffffff;
		border: 1px solid #ede5da;
		padding: 6px 14px;
		border-radius: 16px;
		font-size: 0.85rem;
		color: #4a4a4a;
		text-decoration: none;
		font-weight: 500;
		transition: all 0.2s ease;
	}

	.trend-pills .pill:hover {
		border-color: #c87a54;
		color: #c87a54;
		background: #faf6f0;
	}

	.hero-actions {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
	}

	.btn-hero-primary {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: linear-gradient(135deg, #c87a54, #d4af37);
		color: #ffffff !important;
		font-weight: 600;
		font-size: 1rem;
		padding: 14px 28px;
		border-radius: 30px;
		text-decoration: none;
		box-shadow: 0 6px 20px rgba(200, 122, 84, 0.35);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.btn-hero-primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 25px rgba(200, 122, 84, 0.45);
	}

	.btn-hero-secondary {
		display: inline-flex;
		align-items: center;
		background: #ffffff;
		color: #333333;
		border: 1px solid #d4c8b8;
		font-weight: 600;
		font-size: 1rem;
		padding: 14px 26px;
		border-radius: 30px;
		text-decoration: none;
		transition: background 0.2s ease, border-color 0.2s ease;
	}

	.btn-hero-secondary:hover {
		background: #fdfaf6;
		border-color: #c87a54;
		color: #c87a54;
	}

	.btn-hero-outline {
		display: inline-flex;
		align-items: center;
		background: transparent;
		color: #555;
		border: 1px dashed #c87a54;
		font-weight: 600;
		font-size: 1rem;
		padding: 14px 24px;
		border-radius: 30px;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.btn-hero-outline:hover {
		background: #fdfaf6;
		border-style: solid;
		color: #c87a54;
	}

	/* Trust Strip */
	.trust-strip-section {
		background: #ffffff;
		border-bottom: 1px solid #eee5dd;
		padding: 24px 0;
	}

	.trust-strip-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 20px;
	}

	.trust-strip-item {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.trust-strip-item .trust-icon {
		font-size: 1.6rem;
		flex-shrink: 0;
	}

	.trust-info strong {
		display: block;
		font-size: 0.92rem;
		color: #2c2c2c;
		margin-bottom: 2px;
	}

	.trust-info span {
		font-size: 0.78rem;
		color: #777;
		line-height: 1.3;
		display: block;
	}

	/* Home Comparisons Section */
	.home-comparisons-section {
