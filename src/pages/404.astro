---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
    title="Page Not Found | OraeSkin"
    description="The page you were looking for could not be found. Browse our skincare guides, reviews and categories instead."
    noindex={true}
>
    <Header />
    <main class="notfound-main">
        <section class="container notfound">
            <span class="eyebrow">Error 404</span>
            <h1>We couldn't find that page</h1>
            <p>The link may be old or mistyped. These are good places to start:</p>
            <div class="notfound-links">
                <a href="/blog/" class="btn-primary">Browse All Guides</a>
                <a href="/reviews/" class="btn-secondary">Product Reviews</a>
                <a href="/categories/" class="btn-secondary">Categories</a>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<style>
    .notfound-main { padding: 150px 0 100px; background: #fdfaf6; }
    .notfound { max-width: 640px; margin: 0 auto; text-align: center; }
    .eyebrow { display: inline-block; background: #f5ede4; color: #c87a54; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 14px; margin-bottom: 14px; }
    h1 { font-family: 'Playfair Display', serif; font-size: 2.2rem; color: #2c2c2c; margin: 0 0 12px; }
    p { color: #555; margin-bottom: 28px; }
    .notfound-links { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .btn-primary, .btn-secondary { padding: 10px 22px; border-radius: 25px; font-weight: 600; text-decoration: none; }
    .btn-primary { background: #c87a54; color: #fff; }
    .btn-secondary { border: 1px solid #c87a54; color: #c87a54; }
</style>
