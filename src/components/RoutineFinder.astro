---
import { SITE_CONFIG } from '../config/site';

const amazonTag = SITE_CONFIG.amazon.tag;
---

<section id="routine-finder" class="routine-finder-section">
    <div class="finder-container">
        <div class="finder-header">
            <span class="finder-eyebrow">✨ Evidence-Informed Routine Engine</span>
            <h2 class="finder-title">Find Your Personalized Indian Skincare Routine</h2>
            <p class="finder-subtitle">
                Overwhelmed by conflicting advice? Answer 4 quick questions about your skin, climate, and budget to get a transparent, explainable AM & PM regimen tailored for Indian weather.
            </p>
        </div>

        <!-- Quiz Container Card -->
        <div class="quiz-card" id="quiz-card">
            <!-- Progress Bar -->
            <div class="quiz-progress-bar">
                <div class="progress-fill" id="quiz-progress-fill" style="width: 25%;"></div>
            </div>
            <div class="quiz-step-indicator" id="quiz-step-indicator">Step 1 of 4: Your Skin Type</div>

            <!-- STEP 1: SKIN TYPE -->
            <div class="quiz-step active" id="quiz-step-1">
                <h3 class="step-question">What is your primary skin type?</h3>
                <p class="step-hint">How does your skin feel 2 hours after washing your face without applying any products?</p>
                <div class="options-grid">
                    <button type="button" class="option-btn" data-step="1" data-val="oily">
                        <span class="opt-icon">✨</span>
                        <span class="opt-title">Oily / Shiny</span>
                        <span class="opt-desc">Visible shine across forehead & nose, enlarged pores, midday grease</span>
                    </button>
                    <button type="button" class="option-btn" data-step="1" data-val="dry">
                        <span class="opt-icon">🏜️</span>
                        <span class="opt-title">Dry / Flaky</span>
                        <span class="opt-desc">Tight feeling, rough patches, dullness, needs rich lipid moisture</span>
                    </button>
                    <button type="button" class="option-btn" data-step="1" data-val="combination">
                        <span class="opt-icon">⚖️</span>
                        <span class="opt-title">Combination</span>
                        <span class="opt-desc">Oily T-zone (forehead, nose, chin) with normal or dry cheeks</span>
                    </button>
                    <button type="button" class="option-btn" data-step="1" data-val="sensitive">
                        <span class="opt-icon">🌸</span>
                        <span class="opt-title">Sensitive / Reactive</span>
                        <span class="opt-desc">Stings with fragrances, turns red easily, prone to barrier stinging</span>
                    </button>
                </div>
            </div>

            <!-- STEP 2: CONCERN -->
            <div class="quiz-step" id="quiz-step-2">
                <h3 class="step-question">What is your #1 skincare goal?</h3>
                <p class="step-hint">Select the primary issue you want your active treatments to address.</p>
                <div class="options-grid">
                    <button type="button" class="option-btn" data-step="2" data-val="acne">
                        <span class="opt-icon">🎯</span>
                        <span class="opt-title">Active Acne & Pores</span>
                        <span class="opt-desc">Whiteheads, clogged blackheads, pimples, and excess sebum production</span>
                    </button>
                    <button type="button" class="option-btn" data-step="2" data-val="pigmentation">
                        <span class="opt-icon">☀️</span>
                        <span class="opt-title">Dark Spots & Tanning</span>
                        <span class="opt-desc">Post-inflammatory hyperpigmentation (PIH), sun tan, uneven melanin</span>
                    </button>
                    <button type="button" class="option-btn" data-step="2" data-val="dullness">
                        <span class="opt-icon">💡</span>
                        <span class="opt-title">Dullness & Dehydration</span>
                        <span class="opt-desc">Lacks radiance, feels rough, needs antioxidant plumping & glow</span>
                    </button>
                    <button type="button" class="option-btn" data-step="2" data-val="barrier">
                        <span class="opt-icon">🛡️</span>
                        <span class="opt-title">Damaged Skin Barrier</span>
                        <span class="opt-desc">Stinging, redness, over-exfoliation from acids, needs gentle repair</span>
                    </button>
                </div>
                <div class="step-nav">
                    <button type="button" class="back-btn" id="back-to-step-1">← Back</button>
                </div>
            </div>

            <!-- STEP 3: TEXTURE & CLIMATE -->
            <div class="quiz-step" id="quiz-step-3">
                <h3 class="step-question">What texture best suits your lifestyle and climate?</h3>
                <p class="step-hint">Consider how your skin behaves in tropical humidity, air conditioning, or heat.</p>
                <div class="options-grid">
                    <button type="button" class="option-btn" data-step="3" data-val="matte">
                        <span class="opt-icon">🍃</span>
                        <span class="opt-title">Weightless Matte / Gel</span>
                        <span class="opt-desc">Quick-absorbing, non-greasy finish for high-humidity summers</span>
                    </button>
                    <button type="button" class="option-btn" data-step="3" data-val="dewy">
                        <span class="opt-icon">💧</span>
                        <span class="opt-title">Hydrating Dewy Glow</span>
                        <span class="opt-desc">Luminous, bouncy finish that locks in water without heavy oils</span>
                    </button>
                    <button type="button" class="option-btn" data-step="3" data-val="rich">
                        <span class="opt-icon">🧴</span>
                        <span class="opt-title">Nourishing Barrier Cream</span>
                        <span class="opt-desc">Ceramide-rich seal for dry skin, AC dehydration, or winter months</span>
                    </button>
                    <button type="button" class="option-btn" data-step="3" data-val="fragrance-free">
                        <span class="opt-icon">🔬</span>
                        <span class="opt-title">Fragrance-Free / Clinical</span>
                        <span class="opt-desc">Zero perfumes or essential oils, maximum barrier tolerance</span>
                    </button>
                </div>
                <div class="step-nav">
                    <button type="button" class="back-btn" id="back-to-step-2">← Back</button>
                </div>
            </div>

            <!-- STEP 4: BUDGET -->
            <div class="quiz-step" id="quiz-step-4">
                <h3 class="step-question">What is your preferred product budget tier?</h3>
                <p class="step-hint">We calculate value per ml/g so you get high-efficacy actives without overpaying.</p>
                <div class="options-grid">
                    <button type="button" class="option-btn" data-step="4" data-val="budget">
                        <span class="opt-icon">🏷️</span>
                        <span class="opt-title">Accessible Budget (Under ₹450)</span>
                        <span class="opt-desc">High-value pharmacy & local formulations with zero marketing fluff</span>
                    </button>
                    <button type="button" class="option-btn" data-step="4" data-val="moderate">
                        <span class="opt-icon">⭐</span>
                        <span class="opt-title">Value Mid-Tier (₹450 – ₹750)</span>
                        <span class="opt-desc">Optimal blend of clinical actives, European UV filters, and elegant textures</span>
                    </button>
                    <button type="button" class="option-btn" data-step="4" data-val="premium">
                        <span class="opt-icon">👑</span>
                        <span class="opt-title">Prestige / Dermo (₹750+)</span>
                        <span class="opt-desc">Targeted dermatological formulations with patented delivery systems</span>
                    </button>
                    <button type="button" class="option-btn" data-step="4" data-val="any">
                        <span class="opt-icon">🌟</span>
                        <span class="opt-title">Best Overall Regardless of Price</span>
                        <span class="opt-desc">Ranked strictly by highest OraeSkin Score and formulation efficacy</span>
                    </button>
                </div>
                <div class="step-nav">
                    <button type="button" class="back-btn" id="back-to-step-3">← Back</button>
                </div>
            </div>

            <!-- RESULT SCREEN -->
            <div class="quiz-step" id="quiz-result">
                <div class="result-badge-top">🎯 MATCH COMPLETE — EXPLAINABLE PROTOCOL</div>
                <h3 class="result-title" id="result-title">Your Custom OraeSkin Regimen</h3>
                <p class="result-summary" id="result-summary">
                    Here is your evidence-informed AM & PM protocol curated from our centralized product database. Each recommendation explains exactly why it was selected for your skin profile.
                </p>

                <!-- Routine Tabs -->
                <div class="routine-tabs">
                    <button type="button" class="tab-btn active" id="tab-am">☀️ Morning (AM) Routine</button>
                    <button type="button" class="tab-btn" id="tab-pm">🌙 Night (PM) Routine</button>
                </div>

                <!-- Products Container -->
                <div class="routine-products-grid" id="routine-products-container">
                    <!-- Populated dynamically via JS -->
                </div>

                <!-- Routine Safety & Active Introduction Guidance -->
                <div class="routine-safety-card">
                    <h4>🛡️ Routine Safety & Active Introduction Guidelines</h4>
                    <ul>
                        <li><strong>Patch Test First:</strong> Apply a dime-sized amount of new active treatments behind your ear or inner arm 24 hours before facial use.</li>
                        <li><strong>Introduce Actives Gradually:</strong> Begin using corrective serums 2–3 times a week before increasing to nightly application.</li>
                        <li><strong>Never Skip Daily Sunscreen:</strong> Active treatments (especially exfoliating acids and retinoids) increase skin photosensitivity. Broad-spectrum SPF is non-negotiable.</li>
                        <li><strong>Dermatology Medical Notice:</strong> Skincare guidance on OraeSkin is for educational purposes. If you suffer from cystic or persistent severe acne, consult a board-certified dermatologist.</li>
                    </ul>
                </div>

                <div class="result-actions">
                    <button type="button" class="retake-btn" id="retake-quiz-btn">🔄 Retake Quiz</button>
                    <button type="button" class="share-btn" id="copy-routine-btn">📋 Copy My Routine</button>
                    <a href="/how-we-review/" class="methodology-link-btn">How Products Are Scored →</a>
                </div>
            </div>
        </div>
    </div>
</section>

<script is:inline define:vars={{ amazonTag }}>
(function() {
    const answers = {
        skinType: '',
        concern: '',
        texture: '',
        budget: ''
    };

    // Centralized Product Engine for Routine Builder
    const PRODUCTS_CATALOG = {
        cleansers: {
            oily: {
                id: 'minimalist-salicylic-cleanser',
                name: '2% Salicylic Acid Face Cleanser',
                brand: 'Minimalist',
                price: 299,
                oraeSkinScore: 9.5,
                rating: '4.8 ★ (28k+ reviews)',
                benefit: 'Dissolves trapped pore sebum & prevents blackheads with 2% BHA and LHA.',
                asin: 'B096PJMGPL'
            },
            dry: {
                id: 'cetaphil-gentle-cleanser',
                name: 'Gentle Skin Cleanser',
                brand: 'Cetaphil',
                price: 395,
                oraeSkinScore: 9.3,
                rating: '4.7 ★ (34k+ reviews)',
                benefit: 'Non-foaming, barrier-safe lotion with Niacinamide and Panthenol.',
                asin: 'B01CCGW4OE'
            },
            combination: {
                id: 'cerave-foaming-cleanser',
                name: 'Foaming Facial Cleanser',
                brand: 'CeraVe',
                price: 625,
                oraeSkinScore: 9.6,
                rating: '4.8 ★ (42k+ reviews)',
                benefit: '3 Essential Ceramides + Niacinamide clear pollution without barrier tightness.',
                asin: 'B003YMJJSK'
            },
            sensitive: {
                id: 'simple-refreshing-wash',
                name: 'Kind To Skin Refreshing Facial Wash',
                brand: 'Simple',
                price: 325,
                oraeSkinScore: 9.3,
                rating: '4.6 ★ (22k+ reviews)',
                benefit: '100% soap-free gel with Pro-Vitamin B5 and zero synthetic fragrances.',
                asin: 'B07C3M2RL2'
            }
        },
        serums: {
            acne: {
                id: 'minimalist-niacinamide-10',
                name: '10% Niacinamide Serum with Zinc PCA',
                brand: 'Minimalist',
                price: 599,
                oraeSkinScore: 9.6,
                rating: '4.8 ★ (31k+ reviews)',
                benefit: 'Normalizes sebum, refines congested pores, and soothes inflammatory redness.',
                asin: 'B08F9WPM24'
            },
            pigmentation: {
                id: 'minimalist-alpha-arbutin',
                name: '2% Alpha Arbutin Face Serum',
                brand: 'Minimalist',
                price: 549,
                oraeSkinScore: 9.5,
                rating: '4.7 ★ (19k+ reviews)',
                benefit: 'Inhibits tyrosinase activity to fade stubborn acne marks and sun tanning.',
                asin: 'B08F9W9WCR'
            },
            dullness: {
                id: 'minimalist-vitc-10',
                name: '10% Vitamin C Face Serum',
                brand: 'Minimalist',
                price: 699,
                oraeSkinScore: 9.5,
                rating: '4.7 ★ (22k+ reviews)',
                benefit: 'Stable Ethyl Ascorbic Acid + Centella provides bright antioxidant photoprotection.',
                asin: 'B096VJ969J'
            },
            barrier: {
                id: 'minimalist-b5-moisturizer',
                name: '10% Vitamin B5 Gel',
                brand: 'Minimalist',
                price: 349,
                oraeSkinScore: 9.4,
                rating: '4.6 ★ (15k+ reviews)',
                benefit: 'Re-establishes cellular barrier lipids and dampens active stinging.',
                asin: 'B094R9TFQ2'
            }
        },
        sunscreens: {
            matte: {
                id: 'reequil-ultra-matte-spf50',
                name: 'Ultra Matte Dry Touch Sunscreen SPF 50',
                brand: "Re'equil",
                price: 780,
                oraeSkinScore: 9.5,
                rating: '4.7 ★ (18k+ reviews)',
                benefit: 'Velvety silicone dry-touch finish that resists heavy sweat in tropical weather.',
                asin: 'B07S8W5WJ7'
            },
            dewy: {
                id: 'dermaco-hyaluronic-spf50',
                name: '1% Hyaluronic Sunscreen Aqua Gel',
                brand: 'The Derma Co',
                price: 449,
                oraeSkinScore: 9.5,
                rating: '4.7 ★ (21k+ reviews)',
                benefit: 'Water-burst gel with zero white cast and refreshing lightweight hydration.',
                asin: 'B0BVWDJTHF'
            },
            rich: {
                id: 'drsheths-ceramide-vitc-spf50',
                name: 'Ceramide & Vitamin C Sunscreen',
                brand: "Dr. Sheth's",
                price: 499,
                oraeSkinScore: 9.4,
                rating: '4.6 ★ (16k+ reviews)',
                benefit: 'Ceramides repair while photostable filters shield against UVA/UVB and blue light.',
                asin: 'B0B13RF99G'
            },
            'fragrance-free': {
                id: 'minimalist-spf50',
                name: 'SPF 50 Multi-Vitamin Sunscreen',
                brand: 'Minimalist',
                price: 399,
                oraeSkinScore: 9.6,
                rating: '4.8 ★ (24k+ reviews)',
                benefit: 'Fragrance-free European photostable filters with antioxidant B-vitamins.',
                asin: 'B09FPS9D5T'
            }
        },
        moisturizers: {
            matte: {
                id: 'minimalist-b5-moisturizer',
                name: '10% Vitamin B5 Oil-Free Moisturizer',
                brand: 'Minimalist',
                price: 349,
                oraeSkinScore: 9.4,
                rating: '4.6 ★ (15k+ reviews)',
                benefit: 'Non-comedogenic water gel that restores hydration without greasiness.',
                asin: 'B094R9TFQ2'
            },
            dewy: {
                id: 'dotkey-rice-ceramide-cream',
                name: 'Rice Water & Ceramide Deep Hydrating Cream',
                brand: 'Dot & Key',
                price: 395,
                oraeSkinScore: 9.4,
                rating: '4.7 ★ (18k+ reviews)',
                benefit: 'Fermented rice extract and 5 essential ceramides for supple moisture.',
                asin: 'B0BDVG99J5'
            },
            rich: {
                id: 'cerave-moisturizing-cream',
                name: 'Moisturizing Cream with 3 Ceramides',
                brand: 'CeraVe',
                price: 699,
                oraeSkinScore: 9.6,
                rating: '4.8 ★ (48k+ reviews)',
                benefit: 'Patented MVE multi-vesicular delivery provides 24-hour continuous barrier lipids.',
                asin: 'B00TTD9BRC'
            },
            'fragrance-free': {
                id: 'cerave-moisturizing-cream',
                name: 'Moisturizing Cream with 3 Ceramides',
                brand: 'CeraVe',
                price: 699,
                oraeSkinScore: 9.6,
                rating: '4.8 ★ (48k+ reviews)',
                benefit: 'Fragrance-free, hypoallergenic, clinically formulated for compromised skin.',
                asin: 'B00TTD9BRC'
            }
        }
    };

    function updateStep(step) {
        const fill = document.getElementById('quiz-progress-fill');
        const indicator = document.getElementById('quiz-step-indicator');
        
        document.querySelectorAll('.quiz-step').forEach(el => el.classList.remove('active'));

        if (step === 1) {
            document.getElementById('quiz-step-1').classList.add('active');
            fill.style.width = '25%';
            indicator.textContent = 'Step 1 of 4: Your Skin Type';
        } else if (step === 2) {
            document.getElementById('quiz-step-2').classList.add('active');
            fill.style.width = '50%';
            indicator.textContent = 'Step 2 of 4: Primary Goal';
        } else if (step === 3) {
            document.getElementById('quiz-step-3').classList.add('active');
            fill.style.width = '75%';
            indicator.textContent = 'Step 3 of 4: Texture & Climate Preference';
        } else if (step === 4) {
            document.getElementById('quiz-step-4').classList.add('active');
            fill.style.width = '100%';
            indicator.textContent = 'Step 4 of 4: Budget Tier';
        } else if (step === 5) {
            document.getElementById('quiz-result').classList.add('active');
            fill.style.width = '100%';
            indicator.textContent = '✅ Analysis Complete';
            renderResults();
        }
    }

    // Handle Option Clicks
    document.querySelectorAll('.option-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const step = parseInt(this.getAttribute('data-step'));
            const val = this.getAttribute('data-val');

            if (step === 1) {
                answers.skinType = val;
                updateStep(2);
            } else if (step === 2) {
                answers.concern = val;
                updateStep(3);
            } else if (step === 3) {
                answers.texture = val;
                updateStep(4);
            } else if (step === 4) {
                answers.budget = val;
                updateStep(5);
            }
        });
    });

    // Back buttons
    const back1 = document.getElementById('back-to-step-1');
    if (back1) back1.addEventListener('click', () => updateStep(1));
    const back2 = document.getElementById('back-to-step-2');
    if (back2) back2.addEventListener('click', () => updateStep(2));
    const back3 = document.getElementById('back-to-step-3');
    if (back3) back3.addEventListener('click', () => updateStep(3));

    const retakeBtn = document.getElementById('retake-quiz-btn');
    if (retakeBtn) retakeBtn.addEventListener('click', () => {
        answers.skinType = '';
        answers.concern = '';
        answers.texture = '';
        answers.budget = '';
        updateStep(1);
    });

    let activeRoutineTab = 'am';

    function renderResults() {
        const skinType = answers.skinType || 'combination';
        const concern = answers.concern || 'acne';
        const texture = answers.texture || 'matte';
        const budget = answers.budget || 'moderate';

        const cleanser = PRODUCTS_CATALOG.cleansers[skinType] || PRODUCTS_CATALOG.cleansers.combination;
        const serum = PRODUCTS_CATALOG.serums[concern] || PRODUCTS_CATALOG.serums.acne;
        const sunscreen = PRODUCTS_CATALOG.sunscreens[texture] || PRODUCTS_CATALOG.sunscreens.matte;
        const moisturizer = PRODUCTS_CATALOG.moisturizers[texture] || PRODUCTS_CATALOG.moisturizers.dewy;

        const container = document.getElementById('routine-products-container');
        const verifiedAsins = new Set([
            'B09FPS9D5T', 'B0BVWDJTHF', 'B0BQN2YWN5', 'B003YMJJSK', 
            'B0BDVG99J5', 'B00TTD9BRC', 'B00OZ63ODA', 'B096PJMGPL', 
            'B01CCGW4OE', 'B006NVDWGE', 'B0CJJN6XNK'
        ]);

        function buildCard(stepNum, stepName, prod, whyChose) {
            const affiliateUrl = prod.asin 
                ? 'https://www.amazon.in/dp/' + prod.asin + '?tag=' + amazonTag
                : 'https://www.amazon.in/dp/' + (prod.asin || 'B09FPS9D5T') + '?tag=' + amazonTag;
            const reviewUrl = '/reviews/' + prod.id + '/';

            return `
                <div class="result-product-card">
                    <div class="card-top-row">
                        <span class="prod-step-tag">Step ${stepNum}: ${stepName}</span>
                        <span class="oraeskin-score-badge">Score: <strong>${prod.oraeSkinScore.toFixed(1)}/10</strong></span>
                    </div>
                    <div class="prod-brand">${prod.brand}</div>
                    <h4 class="prod-title">${prod.name}</h4>
                    <div class="prod-meta">
                        <span class="prod-rating">${prod.rating}</span>
                        <span class="prod-price">₹${prod.price}</span>
                    </div>

                    <div class="why-we-chose-box">
                        <span class="why-label">Why We Chose This For You:</span>
                        <p class="why-text">${whyChose}</p>
                    </div>

                    <p class="prod-benefit">${prod.benefit}</p>

                    <div class="prod-actions-row">
                        <a href="${affiliateUrl}" target="_blank" rel="nofollow sponsored noopener" class="prod-cta-btn">
                            <span>Check Price on Amazon</span>
                            <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                            </svg>
                        </a>
                        <a href="${reviewUrl}" class="prod-review-btn">Read Review →</a>
                    </div>
                    <span class="micro-disclosure-text">Affiliate link · At zero extra cost to you.</span>
                </div>
            `;
        }

        const budgetLabel = budget === 'budget' ? 'under ₹500 budget' : (budget === 'premium' ? 'premium clinical tier' : 'balanced value tier');
        const whyCleanser = `Selected for ${skinType} skin and your ${budgetLabel}. This formula cleanses gently without compromising your stratum corneum lipid barrier.`;
        const whySerum = `Selected for ${concern} within your ${budgetLabel}. This active formulation delivers evidence-supported ingredients while remaining comfortable in Indian humidity.`;
        const whySunscreen = `Selected for your ${texture} finish preference and ${budgetLabel}. It delivers PA++++ broad-spectrum defense with zero white cast.`;
        const whyMoisturizer = `Selected for ${skinType} skin and ${budgetLabel}. It provides essential barrier restoration without heavy comedogenic pore clogging.`;

        if (activeRoutineTab === 'am') {
            container.innerHTML = `
                ${buildCard(1, 'Morning Cleanse', cleanser, whyCleanser)}
                ${buildCard(2, 'Target Treatment', serum, whySerum)}
                ${buildCard(3, 'Broad-Spectrum SPF 50', sunscreen, whySunscreen)}
            `;
        } else {
            container.innerHTML = `
                ${buildCard(1, 'Evening Cleanse', cleanser, whyCleanser)}
                ${buildCard(2, 'Night Treatment', serum, whySerum)}
                ${buildCard(3, 'Night Barrier Seal', moisturizer, whyMoisturizer)}
            `;
        }
    }

    const tabAm = document.getElementById('tab-am');
    const tabPm = document.getElementById('tab-pm');
    if (tabAm && tabPm) {
        tabAm.addEventListener('click', () => {
            tabAm.classList.add('active');
            tabPm.classList.remove('active');
            activeRoutineTab = 'am';
            renderResults();
        });
        tabPm.addEventListener('click', () => {
            tabPm.classList.add('active');
            tabAm.classList.remove('active');
            activeRoutineTab = 'pm';
            renderResults();
        });
    }

    const copyBtn = document.getElementById('copy-routine-btn');
    if (copyBtn) {
        copyBtn.addEventListener('click', () => {
            const text = 'My OraeSkin Regimen:\\nSkin: ' + answers.skinType + ' | Focus: ' + answers.concern + ' | Texture: ' + answers.texture + ' | Budget: ' + answers.budget + '\\nFind yours on: https://www.oraeskin.in/#routine-finder';
            navigator.clipboard.writeText(text).then(() => {
                copyBtn.textContent = '✓ Routine Copied!';
                setTimeout(() => { copyBtn.textContent = '📋 Copy My Routine'; }, 2000);
            });
        });
    }
})();
</script>

<style>
    .routine-finder-section {
        padding: 5rem 1rem;
