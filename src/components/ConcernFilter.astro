---
const concerns = [
    { id: 'acne', name: 'Acne & Blemishes', icon: '✨', count: '12+ Guides' },
    { id: 'sun', name: 'Sun Protection & Tanning', icon: '☀️', count: '8+ Top Sunscreens' },
    { id: 'oily', name: 'Oily Skin & Pores', icon: '💧', count: '10+ Cleansers' },
    { id: 'pigmentation', name: 'Dark Spots & Pigmentation', icon: '🌟', count: '9+ Serums' },
    { id: 'dry', name: 'Dry & Sensitive Skin', icon: '🌿', count: '7+ Barrier Creams' },
    { id: 'glow', name: 'Glass Skin & Glow', icon: '💎', count: '14+ Holy Grails' },
];
---

<section id="concerns" class="concerns-section">
    <div class="container">
        <div class="section-header-center">
            <span class="eyebrow">Targeted Skincare</span>
            <h2>Shop by Indian Skin Concern</h2>
            <p class="subtitle">Find dermatologist-recommended formulas tested for Indian humidity, pollution, and melanin-rich skin.</p>
        </div>

        <div class="concerns-grid">
            {concerns.map((c) => (
                <a href={`/blog#${c.id}`} class="concern-card">
                    <span class="concern-icon">{c.icon}</span>
                    <div class="concern-text">
                        <h4>{c.name}</h4>
                        <span class="concern-count">{c.count}</span>
                    </div>
                    <span class="arrow-icon">→</span>
                </a>
            ))}
        </div>
    </div>
</section>

<style>
    .concerns-section {
        padding: 60px 0;
        background: #fdfaf6;
        border-top: 1px solid #f0eae1;
        border-bottom: 1px solid #f0eae1;
    }

    .section-header-center {
        text-align: center;
        max-width: 680px;
        margin: 0 auto 40px auto;
    }

    .eyebrow {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        color: #c87a54;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
    }

    .section-header-center h2 {
        font-family: 'Playfair Display', serif;
        font-size: 2.2rem;
        color: #2c2c2c;
        margin-bottom: 12px;
    }

    .subtitle {
        color: #666;
        font-size: 1rem;
        line-height: 1.6;
        margin: 0;
    }

    .concerns-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
    }

    .concern-card {
        background: #ffffff;
        border: 1px solid #ede5da;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .concern-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.06);
        border-color: #c87a54;
    }

    .concern-icon {
        font-size: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        background: #faf6f0;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .concern-text {
        flex: 1;
    }

    .concern-text h4 {
        margin: 0 0 4px 0;
        font-size: 1.05rem;
        color: #2c2c2c;
        font-weight: 600;
    }

    .concern-count {
        font-size: 0.82rem;
        color: #888;
    }

    .arrow-icon {
        color: #c87a54;
        font-weight: 700;
        font-size: 1.2rem;
        transition: transform 0.2s ease;
    }

    .concern-card:hover .arrow-icon {
        transform: translateX(4px);
    }
</style>
