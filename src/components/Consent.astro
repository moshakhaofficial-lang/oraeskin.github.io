---
---
<div id="consent-banner" class="consent-banner">
    <div class="consent-content">
        <p>We use cookies to analyze our traffic and improve your experience. By clicking "Accept", you consent to our use of cookies.</p>
        <div class="consent-buttons">
            <button id="accept-cookies" class="btn-accept">Accept</button>
            <button id="decline-cookies" class="btn-decline">Decline</button>
        </div>
    </div>
</div>

<script>
    declare global {
        interface Window {
            gtag?: (...args: any[]) => void;
        }
    }

    const banner = document.getElementById('consent-banner');
    const acceptBtn = document.getElementById('accept-cookies');
    const declineBtn = document.getElementById('decline-cookies');

    // Check if user has already made a choice
    if (!localStorage.getItem('cookieConsent')) {
        // Show banner after a small delay
        setTimeout(() => {
            banner?.classList.add('visible');
        }, 1000);
    } else {
        // If accepted previously, ensure config is updated (though default is usually 'granted' if script loaded, 
        // proper implementation would set default 'denied' in head and update here. 
        // For simplicity, we just hide banner if choice made.)
        const consent = localStorage.getItem('cookieConsent');
        if (consent === 'granted') {
             window.gtag?.('consent', 'update', {
                'analytics_storage': 'granted'
            });
        }
    }

    acceptBtn?.addEventListener('click', () => {
        localStorage.setItem('cookieConsent', 'granted');
        banner?.classList.remove('visible');
        
        // Update Google Consent Mode
        window.gtag?.('consent', 'update', {
            'analytics_storage': 'granted'
        });
    });

    declineBtn?.addEventListener('click', () => {
        localStorage.setItem('cookieConsent', 'denied');
        banner?.classList.remove('visible');
        
        // Explicitly confirm analytics remains denied
        window.gtag?.('consent', 'update', {
            'analytics_storage': 'denied'
        });
    });
</script>

<style>
    .consent-banner {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background-color: var(--primary-cream);
        border-top: 1px solid var(--soft-beige);
        box-shadow: 0 -4px 20px rgba(0,0,0,0.05);
        padding: 20px;
        z-index: 9999;
        transform: translateY(100%);
        transition: transform 0.5s ease;
    }

    .consent-banner.visible {
        transform: translateY(0);
    }

    .consent-content {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .consent-content p {
        margin: 0;
        font-size: 0.9rem;
        color: var(--charcoal);
        flex: 1;
    }

    .consent-buttons {
        display: flex;
        gap: 10px;
    }

    .btn-accept, .btn-decline {
        padding: 10px 20px;
        border-radius: 5px;
        cursor: pointer;
        font-family: inherit;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-accept {
        background-color: var(--warm-terracotta);
        color: white;
        border: none;
    }

    .btn-accept:hover {
        background-color: var(--sage-green);
    }

    .btn-decline {
        background-color: transparent;
        border: 1px solid var(--charcoal);
        color: var(--charcoal);
    }

    .btn-decline:hover {
        background-color: #f1f1f1;
    }

    @media (max-width: 768px) {
        .consent-content {
            flex-direction: column;
            text-align: center;
        }
    }
</style>
