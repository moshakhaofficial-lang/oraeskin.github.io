---
import { getAmazonAffiliateUrl } from '../config/site';

interface Props {
    title: string;
    brand?: string;
    asinOrUrl: string;
    rating?: string;
    priceEst?: string;
    image?: string;
    label?: string;
    /** Element id the bar waits on: it appears once that element has scrolled out of view */
    after?: string;
}

const { title, brand, asinOrUrl, rating, priceEst, image, label = 'Top pick in this guide', after = 'top-pick-box' } = Astro.props;

const affiliateUrl = getAmazonAffiliateUrl(asinOrUrl);
---

<div id="sticky-action-bar" class="sticky-action-bar" data-after={after} aria-hidden="true">
    <div class="sticky-inner">
        {image && <img class="sticky-thumb" src={image} alt="" width="44" height="44" loading="lazy" decoding="async" />}
        <div class="sticky-info">
            <span class="sticky-tag">{label}</span>
            <div class="sticky-product-title">{brand && <strong>{brand} </strong>}{title}</div>
            <div class="sticky-meta">
                {priceEst && <span class="sticky-price">{priceEst}</span>}
                {rating && <span class="sticky-rating">★ {rating} on Amazon</span>}
            </div>
        </div>
        <a href={affiliateUrl} target="_blank" rel="nofollow sponsored noopener" class="btn-buy small sticky-cta" data-placement="sticky_bar">
            Check price →
        </a>
        <button type="button" id="close-sticky-bar" class="sticky-close" aria-label="Dismiss">✕</button>
    </div>
</div>

<script is:inline>
(function () {
    const bar = document.getElementById('sticky-action-bar');
    if (!bar) return;
    let dismissed = false;
    const show = (on) => {
        if (dismissed) on = false;
        bar.classList.toggle('visible', on);
        bar.setAttribute('aria-hidden', String(!on));
    };

    const anchor = document.getElementById(bar.dataset.after);
    if (anchor && 'IntersectionObserver' in window) {
        // Appear only after the in-page buy box has scrolled away above the viewport
        new IntersectionObserver(([e]) => show(!e.isIntersecting && e.boundingClientRect.bottom < 0)).observe(anchor);
    } else {
        window.addEventListener('scroll', () => show(window.scrollY > 500), { passive: true });
    }

    document.getElementById('close-sticky-bar')?.addEventListener('click', () => {
        dismissed = true;
        show(false);
    });
})();
</script>

<style>
    .sticky-action-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(255, 255, 255, 0.97);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-top: 1px solid var(--line);
        box-shadow: 0 -6px 22px rgba(34, 29, 25, 0.1);
        padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
        z-index: 999;
        transform: translateY(110%);
        visibility: hidden;
        transition: transform 0.3s ease, visibility 0.3s;
    }

    .sticky-action-bar.visible {
        transform: translateY(0);
        visibility: visible;
    }

    .sticky-inner {
        max-width: 840px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sticky-thumb {
        flex: 0 0 44px;
        height: 44px;
        object-fit: contain;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 8px;
    }

    .sticky-info {
        flex: 1;
        min-width: 0;
    }

    .sticky-tag {
        display: block;
        font-size: 0.62rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent);
    }

    .sticky-product-title {
        font-size: 0.88rem;
        line-height: 1.3;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sticky-meta {
        display: flex;
        gap: 10px;
        font-size: 0.78rem;
        color: var(--ink-soft);
    }

    .sticky-price {
        font-weight: 700;
        color: var(--ink);
    }

    .sticky-cta {
        flex-shrink: 0;
        white-space: nowrap;
    }

    .sticky-close {
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        background: transparent;
        border: none;
        color: var(--ink-mute);
        font-size: 0.95rem;
        cursor: pointer;
        line-height: 1;
    }

    .sticky-close:hover {
        color: var(--ink);
    }

    @media (max-width: 480px) {
        .sticky-tag,
        .sticky-rating {
            display: none;
        }

        .sticky-inner {
            gap: 10px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .sticky-action-bar {
            transition: none;
        }
    }
</style>
