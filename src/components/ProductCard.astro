---
import { getAmazonAffiliateUrl } from '../config/site';

interface Props {
    title: string;
    brand: string;
    image: string;
    asinOrUrl: string;
    id?: string;
    oraeSkinScore?: number;
    rating?: number;
    reviewCount?: string;
    badge?: string;
    bestFor?: string;
    keyIngredients?: string[];
    pros?: string[];
    cons?: string[];
    priceEstimate?: string;
    rank?: number;
    reviewUrl?: string;
}

const {
    title,
    brand,
    image,
    asinOrUrl,
    id,
    oraeSkinScore = 9.2,
    rating = 4.7,
    reviewCount = '1,200+',
    badge = "Editor's Choice",
    bestFor,
    keyIngredients = [],
    pros = [],
    cons = [],
    priceEstimate,
    rank,
    reviewUrl = id ? `/reviews/${id}/` : undefined
} = Astro.props;

const affiliateUrl = getAmazonAffiliateUrl(asinOrUrl);
---

<div class="affiliate-product-card" id={`product-${rank || id || 1}`}>
    {badge && <div class="product-badge">{badge}</div>}
    
    <div class="product-main-grid">
        <div class="product-image-col">
            {rank && <span class="rank-indicator">#{rank}</span>}
            <div class="product-img-wrapper">
                <img src={image} alt={`${brand} ${title}`} loading="lazy" decoding="async" width="180" height="180" />
            </div>
            
            <!-- Dual Score Display -->
            <div class="score-pill-card">
                <div class="oraeskin-score-tag">
                    <span class="score-tag-label">OraeSkin Score</span>
                    <span class="score-tag-val">{oraeSkinScore.toFixed(1)}<span class="score-tag-max">/10</span></span>
                </div>
            </div>
        </div>

        <div class="product-info-col">
            <span class="product-brand">{brand}</span>
            <h3 class="product-title">{title}</h3>

            <div class="product-meta-row">
                <div class="star-rating" title={`Amazon Customer Rating: ${rating} out of 5 stars`}>
                    <span class="stars">★★★★★</span>
                    <span class="rating-score">{rating}/5</span>
                    <span class="review-count">({reviewCount} Amazon reviews)</span>
                </div>
                {priceEstimate && <span class="price-pill">{priceEstimate}</span>}
            </div>

            {bestFor && (
                <div class="best-for-row">
                    <span class="best-for-label">Best Suited For:</span>
                    <span class="best-for-val">{bestFor}</span>
                </div>
            )}

            {keyIngredients.length > 0 && (
                <div class="ingredients-tags">
                    {keyIngredients.map((item) => (
                        <span class="ingredient-tag">{item}</span>
                    ))}
                </div>
            )}

            {(pros.length > 0 || cons.length > 0) && (
                <div class="pros-cons-grid">
                    {pros.length > 0 && (
                        <div class="pros-col">
                            <span class="pros-title">✓ Why We Recommend It</span>
                            <ul>
                                {pros.slice(0, 3).map((p) => <li>{p}</li>)}
                            </ul>
                        </div>
                    )}
                    {cons.length > 0 && (
                        <div class="cons-col">
                            <span class="cons-title">✗ Important Limitation</span>
                            <ul>
                                {cons.slice(0, 2).map((c) => <li>{c}</li>)}
                            </ul>
                        </div>
                    )}
                </div>
            )}

            <div class="product-cta-container">
                <div class="product-cta-buttons">
                    <a 
                        href={affiliateUrl} 
                        target="_blank" 
                        rel="nofollow sponsored noopener" 
                        class="btn-amazon"
                    >
                        <span>Check Price on Amazon</span>
                        <svg class="external-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                    </a>

                    {reviewUrl && (
                        <a href={reviewUrl} class="btn-review">
                            <span>Read Editorial Review →</span>
                        </a>
                    )}
                </div>

                <div class="affiliate-micro-disclosure">
                    <span>Affiliate link · We may earn a commission at no extra cost to you.</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .affiliate-product-card {
        background: #ffffff;
        border: 1px solid #ede5da;
        border-radius: 16px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
        padding: 28px;
        margin: 32px 0;
        position: relative;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .affiliate-product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 40px rgba(0, 0, 0, 0.08);
    }

    .product-badge {
        position: absolute;
        top: -12px;
        left: 28px;
        background: linear-gradient(135deg, #c87a54, #d4af37);
        color: #ffffff;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 4px 14px;
        border-radius: 20px;
        box-shadow: 0 4px 12px rgba(200, 122, 84, 0.35);
    }

    .product-main-grid {
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: 28px;
        align-items: start;
    }

    .product-image-col {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #fdfaf6;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #f0eae1;
    }

    .rank-indicator {
        position: absolute;
        top: 10px;
        left: 10px;
        background: #2c2c2c;
        color: #fff;
        font-size: 0.8rem;
        font-weight: 700;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-img-wrapper {
        width: 100%;
        max-width: 180px;
        height: 190px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-img-wrapper img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        border-radius: 8px;
    }

    .score-pill-card {
        width: 100%;
        margin-top: 14px;
        text-align: center;
    }

    .oraeskin-score-tag {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        background: linear-gradient(135deg, #2c2c2c 0%, #1e1e1e 100%);
        color: #fff;
        padding: 6px 14px;
        border-radius: 8px;
        width: 100%;
        box-sizing: border-box;
    }

    .score-tag-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #d1bba4;
        font-weight: 600;
    }

    .score-tag-val {
        font-size: 1.25rem;
        font-weight: 800;
        color: #f7a87b;
        line-height: 1.1;
    }

    .score-tag-max {
        font-size: 0.75rem;
        color: #a89f91;
    }

    .product-brand {
        display: inline-block;
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #c87a54;
        letter-spacing: 1.2px;
        margin-bottom: 4px;
    }

    .product-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.4rem;
        line-height: 1.3;
        color: #2c2c2c;
        margin: 0 0 10px 0;
    }

    .product-meta-row {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 12px;
        flex-wrap: wrap;
    }

    .star-rating {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.88rem;
    }

    .stars {
        color: #f59e0b;
        letter-spacing: 1px;
    }

    .rating-score {
        font-weight: 700;
        color: #333;
    }

    .review-count {
        color: #777;
        font-size: 0.82rem;
    }

    .price-pill {
        background: #eef7ee;
        color: #2b7a2b;
        font-weight: 700;
        font-size: 0.88rem;
        padding: 3px 12px;
        border-radius: 20px;
    }

    .best-for-row {
        background: #faf6f0;
        border-radius: 8px;
        padding: 8px 14px;
        font-size: 0.88rem;
        margin-bottom: 12px;
    }

    .best-for-label {
        font-weight: 700;
        color: #4a3e36;
        margin-right: 6px;
    }

    .best-for-val {
        color: #6a5a4e;
    }

    .ingredients-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 16px;
    }

    .ingredient-tag {
        background: #f0ebe4;
        color: #555;
        font-size: 0.78rem;
        padding: 3px 10px;
        border-radius: 12px;
        font-weight: 500;
    }

    .pros-cons-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin: 16px 0;
        font-size: 0.86rem;
    }

    .pros-col, .cons-col {
        background: #faf8f5;
        border-radius: 8px;
        padding: 12px 14px;
    }

    .pros-title {
        display: block;
        font-weight: 700;
        color: #2e7d32;
        margin-bottom: 6px;
    }

    .cons-title {
        display: block;
        font-weight: 700;
        color: #c62828;
        margin-bottom: 6px;
    }

    .pros-col ul, .cons-col ul {
        margin: 0;
        padding-left: 18px;
        color: #444;
    }

    .pros-col li, .cons-col li {
        margin-bottom: 4px;
        line-height: 1.4;
    }

    .product-cta-container {
        margin-top: 20px;
        padding-top: 14px;
        border-top: 1px solid #f0eae1;
    }

    .product-cta-buttons {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-amazon {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #e8863d, #c87a54);
        color: #ffffff !important;
        font-weight: 700;
        font-size: 0.95rem;
        padding: 12px 22px;
        border-radius: 28px;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(200, 122, 84, 0.3);
        transition: all 0.25s ease;
    }

    .btn-amazon:hover {
        background: linear-gradient(135deg, #d3732b, #b3633d);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(200, 122, 84, 0.4);
    }

    .btn-review {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: transparent;
        color: #2c2c2c !important;
        font-weight: 600;
        font-size: 0.92rem;
        padding: 10px 18px;
        border-radius: 28px;
        border: 1px solid #dcd3c8;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-review:hover {
        background: #faf6f0;
        border-color: #c87a54;
        color: #c87a54 !important;
    }

    .external-icon {
        opacity: 0.85;
    }

    .affiliate-micro-disclosure {
        margin-top: 10px;
        font-size: 0.76rem;
        color: #888;
        line-height: 1.4;
    }

    @media (max-width: 768px) {
        .product-main-grid {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .product-image-col {
            padding: 14px;
        }

        .product-img-wrapper {
            height: 160px;
        }

        .pros-cons-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .product-cta-buttons {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-amazon, .btn-review {
            justify-content: center;
            text-align: center;
        }

        .affiliate-micro-disclosure {
            text-align: center;
        }
    }
</style>
