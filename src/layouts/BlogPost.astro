---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import RelatedProducts from '../components/RelatedProducts.astro';
import { getRelatedProducts, PRODUCTS } from '../data/products';
import { getAmazonAffiliateUrl, PRODUCT_SEARCH_FALLBACKS } from '../config/site';
import fs from 'node:fs';

const { frontmatter } = Astro.props;
const siteUrl = 'https://www.oraeskin.in';
const currentUrl = `${siteUrl}${Astro.url.pathname}`;
const articleImage = frontmatter.image?.startsWith('http') 
    ? frontmatter.image 
    : `${siteUrl}${frontmatter.image || '/images/Oraeskin_FBCover.png'}`;

// Products linked in the article body come first, then topic matches
const rawContent = Astro.props.file ? fs.readFileSync(Astro.props.file, 'utf8') : '';
const mentionedAsins = [...new Set([...rawContent.matchAll(/amazon\.in\/dp\/([A-Z0-9]{10})/gi)].map(m => m[1]))];
// Reading time from the article body at ~200 words per minute
const bodyText = rawContent.replace(/^---[\s\S]*?\n---\n/, '').replace(/\]\([^)]*\)/g, ']').replace(/[#*|>_`\-[\]]/g, ' ');
const readMinutes = Math.max(2, Math.round(bodyText.split(/\s+/).filter(Boolean).length / 200));
const topicText = [frontmatter.title, frontmatter.category, frontmatter.keywords, frontmatter.description].filter(Boolean).join(' ');
const relatedProducts = getRelatedProducts(topicText, mentionedAsins);

// Top pick shown above the fold and in the sticky bar. Live product data wins over frontmatter.
// Guides without a named top pick feature the first reviewed product they link to instead.
const resolveAsin = (a: string) => PRODUCT_SEARCH_FALLBACKS[a] || a;
const firstReviewed = mentionedAsins.map(resolveAsin).find(a => PRODUCTS.some(p => p.asin === a && p.inStock));
const pickAsin = frontmatter.topPickAsin ? resolveAsin(frontmatter.topPickAsin) : firstReviewed;
const pickLabel = frontmatter.topPickAsin ? 'Our top pick in this guide' : 'Featured in this guide';
const pickProduct = pickAsin ? PRODUCTS.find(p => p.asin === pickAsin && p.inStock) : undefined;
const topPick = pickAsin && frontmatter.noindex !== true ? {
    asin: pickAsin,
    url: getAmazonAffiliateUrl(pickAsin),
    brand: pickProduct?.brand || frontmatter.topPickBrand || '',
    title: pickProduct?.name || frontmatter.topPickTitle || '',
    image: pickProduct?.image,
    rating: pickProduct?.amazonRating ?? (parseFloat(frontmatter.topPickRating) || undefined),
    reviews: pickProduct?.amazonReviews,
    price: pickProduct?.priceEst || frontmatter.topPickPrice,
    priceChecked: pickProduct?.lastPriceChecked,
    score: pickProduct?.oraeSkinScore,
    bestFor: pickProduct?.bestFor,
    reviewUrl: pickProduct ? `/reviews/${pickProduct.id}/` : undefined,
} : undefined;

const rawDate = frontmatter.updated || frontmatter.date;
const displayDate = rawDate && !isNaN(new Date(rawDate).getTime())
    ? new Date(rawDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
    : (rawDate || 'September 2026');
---

<Layout
    title={`${frontmatter.title} | OraeSkin`}
    description={frontmatter.description}
    image={articleImage}
    keywords={frontmatter.keywords || "skincare reviews, amazon india skincare, best skincare products, indian skin routines, OraeSkin"}
    ogType="article"
    noindex={frontmatter.noindex === true}
>
    <!-- Structured Data (JSON-LD) -->
    <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": frontmatter.title,
        "image": [articleImage],
        "datePublished": frontmatter.date || "2026-01-01",
        "dateModified": frontmatter.updated || frontmatter.date || "2026-03-01",
        "author": {
            "@type": "Organization",
            "name": "OraeSkin Editorial Team",
            "url": siteUrl
        },
        "publisher": {
            "@type": "Organization",
            "name": "OraeSkin",
            "logo": {
                "@type": "ImageObject",
                "url": `${siteUrl}/images/logo_opt.png`
            }
        },
        "description": frontmatter.description,
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": currentUrl
        }
    })} />
    
    <Header />
    <main class="blog-article-main">
        <article class="container blog-container">
            <header class="article-header">
                {frontmatter.category && (
                    <span class="category-pill">{frontmatter.category}</span>
                )}
                <h1 class="article-title">{frontmatter.title}</h1>
                
                <div class="article-meta">
                    <span class="author-label">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
                        </svg>
                        OraeSkin Editorial Team
                    </span>
                    <span class="meta-sep">•</span>
                    <span class="date-label">Updated {displayDate}</span>
                    <span class="meta-sep">•</span>
                    <span class="read-time">{readMinutes} Min Read</span>
                </div>

                <p class="disclosure-line">
                    We earn a commission when you buy through Amazon links on this page, at no extra cost to you. <a href="/disclosure/">How we earn</a>
                </p>

                {topPick && topPick.title ? (
                    <div class="top-pick-box" id="top-pick-box">
                        <span class="tp-label">{pickLabel}</span>
                        <div class="tp-main">
                            {topPick.image && (
                                <a href={topPick.url} target="_blank" rel="nofollow sponsored noopener" class="tp-img" data-placement="guide_top_pick_image" tabindex="-1" aria-hidden="true">
                                    <img src={topPick.image} alt="" width="120" height="120" fetchpriority="high" />
                                </a>
                            )}
                            <div class="tp-info">
                                <span class="tp-brand">{topPick.brand}</span>
                                <strong class="tp-title">{topPick.title}</strong>
                                <div class="tp-meta">
                                    {topPick.rating && (
                                        <span class="tp-rating">
                                            <span class="star-meter" style={`--rating: ${topPick.rating}`} aria-hidden="true"></span>
                                            <span>{topPick.rating.toFixed(1)} on Amazon{topPick.reviews ? ` (${topPick.reviews})` : ''}</span>
                                        </span>
                                    )}
                                    {topPick.score && <span class="tp-score">OraeSkin Score {topPick.score.toFixed(1)}/10</span>}
                                </div>
                                {topPick.bestFor && <p class="tp-best"><strong>Best for:</strong> {topPick.bestFor}</p>}
                            </div>
                        </div>
                        <div class="tp-actions">
                            <a href={topPick.url} target="_blank" rel="nofollow sponsored noopener" class="btn-buy" data-placement="guide_top_pick">
                                {topPick.price ? `Check price on Amazon · ${topPick.price}` : 'Check price on Amazon'}{'\u00a0→'}
                            </a>
                            {topPick.reviewUrl && <a href={topPick.reviewUrl} class="tp-review">Read our review</a>}
                        </div>
                        {topPick.priceChecked && <p class="tp-note">Price last checked {topPick.priceChecked}. Amazon's price may have changed.</p>}
                    </div>
                ) : frontmatter.image && (
                    <div class="hero-image-wrapper">
                        <img src={frontmatter.image} alt={frontmatter.title} class="article-hero-img" width="800" height="800" fetchpriority="high" />
                    </div>
                )}
            </header>

            <div class="article-content">
                <slot />
            </div>

            <RelatedProducts products={relatedProducts} />

            <footer class="article-bottom-bar">
                <div class="author-bio-card">
                    <div class="bio-avatar">
                        <img src="/images/favicon-logo.png" alt="OraeSkin Editorial" width="48" height="48" loading="lazy" />
                    </div>
                    <div class="bio-text">
                        <h4>OraeSkin Editorial Team</h4>
                        <p>We research, analyze ingredient formulations, and curate top skincare products available on Amazon India to help you find evidence-informed skincare.</p>
                    </div>
                </div>

                <div class="article-nav-actions">
                    <a href="/blog/" class="btn-back">← Back to All Guides & Reviews</a>
                    <a href="/#top-picks" class="btn-top-picks">Explore Top Amazon Deals →</a>
                </div>
            </footer>
        </article>
    </main>
    {topPick && topPick.title && (
        <MobileStickyBar
            title={topPick.title}
            brand={topPick.brand}
            asinOrUrl={topPick.asin}
            rating={topPick.rating ? topPick.rating.toFixed(1) : undefined}
            priceEst={topPick.price}
            image={topPick.image}
            label={pickLabel.replace('Our top', 'Top')}
        />
    )}
    <Footer />
</Layout>

<style>
    .blog-article-main {
        padding-top: 105px;
        padding-bottom: 60px;
        background: #fdfaf6;
    }

    .blog-container {
        max-width: 840px;
        margin: 0 auto;
        background: #ffffff;
        padding: 36px 40px;
        border-radius: 16px;
        border: 1px solid #ede5da;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
    }

    .article-header {
        margin-bottom: 36px;
    }

    .category-pill {
        display: inline-block;
        background: #f5ede4;
        color: #c87a54;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 4px 12px;
        border-radius: 14px;
        margin-bottom: 14px;
    }

    .article-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.4rem;
        line-height: 1.25;
        color: #2c2c2c;
        margin: 0 0 16px 0;
    }

    .article-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #777;
        font-size: 0.88rem;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .author-label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #555;
        font-weight: 500;
    }

    .meta-sep {
        color: #ccc;
    }

    .hero-image-wrapper {
        margin-top: 20px;
        border-radius: 12px;
        overflow: hidden;
        max-height: 320px;
    }

    .disclosure-line {
        margin: 0;
        font-size: 0.82rem;
        line-height: 1.5;
        color: var(--ink-mute);
    }

    .disclosure-line a {
        color: var(--accent);
        font-weight: 600;
    }

    .top-pick-box {
        margin-top: 20px;
        padding: 18px;
        background: linear-gradient(180deg, #fffaf0 0%, #ffffff 70%);
        border: 1px solid #f0dfb8;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
    }

    .tp-label {
        display: inline-block;
        margin-bottom: 12px;
        padding: 4px 10px;
        background: var(--ink);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        border-radius: 6px;
    }

    .tp-main {
        display: flex;
        gap: 16px;
        align-items: flex-start;
    }

    .tp-img {
        flex: 0 0 108px;
        height: 108px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 10px;
        overflow: hidden;
    }

    .tp-img img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .tp-info {
        min-width: 0;
    }

    .tp-brand {
        display: block;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--accent);
    }

    .tp-title {
        display: block;
        font-family: 'Playfair Display', serif;
        font-size: 1.2rem;
        line-height: 1.3;
        color: var(--ink);
        margin: 2px 0 8px;
    }

    .tp-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 14px;
        align-items: center;
        font-size: 0.84rem;
        color: var(--ink-soft);
    }

    .tp-rating {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    .tp-score {
        padding: 2px 8px;
        background: var(--accent-soft);
        color: var(--accent);
        font-weight: 700;
        border-radius: 6px;
    }

    .tp-best {
        margin: 8px 0 0;
        font-size: 0.88rem;
        line-height: 1.45;
        color: var(--ink-soft);
    }

    .tp-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 18px;
        margin-top: 16px;
    }

    .tp-review {
        color: var(--accent);
        font-weight: 600;
        font-size: 0.92rem;
    }

    .tp-note {
        margin: 10px 0 0;
        font-size: 0.76rem;
        color: var(--ink-mute);
    }

    .article-hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .article-content {
        font-size: 1.05rem;
        line-height: 1.7;
        color: #333333;
    }

    .article-content :global(h2) {
        font-family: 'Playfair Display', serif;
        font-size: 1.55rem;
        color: #2c2c2c;
        margin-top: 28px;
        margin-bottom: 12px;
        border-bottom: 1px solid #f0eae1;
        padding-bottom: 6px;
    }

    .article-content :global(h3) {
        font-family: 'Playfair Display', serif;
        font-size: 1.25rem;
        color: #3a3a3a;
        margin-top: 20px;
        margin-bottom: 10px;
    }

    .article-content :global(p) {
        margin-bottom: 14px;
    }

    .article-content :global(ul), .article-content :global(ol) {
        margin-bottom: 18px;
        padding-left: 24px;
    }

    .article-content :global(li) {
        margin-bottom: 8px;
    }

    .article-content :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 28px 0;
        font-size: 0.95rem;
    }

    /* Wide comparison tables scroll inside themselves instead of widening the page */
    @media (max-width: 768px) {
        .article-content :global(table) {
            display: block;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            font-size: 0.88rem;
        }

        .article-content :global(th),
        .article-content :global(td) {
            min-width: 120px;
            padding: 10px 12px;
        }
    }

    .article-content :global(th) {
        background: #faf6f0;
        padding: 12px 14px;
        text-align: left;
        border-bottom: 2px solid #e8dfd3;
        font-weight: 600;
        color: #4a3e36;
    }

    .article-content :global(td) {
        padding: 12px 14px;
        border-bottom: 1px solid #f0eae1;
    }

    .article-content :global(a) {
        color: #c87a54;
        font-weight: 600;
        text-decoration: underline;
    }

    .article-content :global(a:hover) {
        color: #a85d38;
    }

    .article-bottom-bar {
        margin-top: 60px;
        border-top: 1px solid #ede5da;
        padding-top: 40px;
    }

    .author-bio-card {
        display: flex;
        align-items: center;
        gap: 18px;
        background: #fdfaf6;
        padding: 24px;
        border-radius: 12px;
        border: 1px solid #f0eae1;
        margin-bottom: 36px;
    }

    .bio-avatar img {
        border-radius: 50%;
        background: #fff;
        padding: 4px;
        border: 1px solid #e8dfd3;
    }

    .bio-text h4 {
        margin: 0 0 6px 0;
        font-size: 1.05rem;
        color: #2c2c2c;
    }

    .bio-text p {
        margin: 0;
        font-size: 0.9rem;
        color: #666;
        line-height: 1.5;
    }

    .article-nav-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .btn-back {
        color: #555;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: color 0.2s ease;
    }

    .btn-back:hover {
        color: #c87a54;
    }

    .btn-top-picks {
        background: #c87a54;
        color: #fff !important;
        text-decoration: none;
        padding: 10px 22px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 0.92rem;
        transition: background 0.2s ease;
    }

    .btn-top-picks:hover {
        background: #a85d38;
    }

    @media (max-width: 768px) {
        .blog-container {
            padding: 24px 18px;
            border-radius: 0;
            border: none;
        }

        .article-title {
            font-size: 1.7rem;
        }

        .article-header {
            margin-bottom: 24px;
        }

        .top-pick-box {
            padding: 14px;
        }

        .tp-img {
            flex-basis: 84px;
            height: 84px;
        }

        .tp-title {
            font-size: 1.05rem;
        }

        .tp-best {
            display: none;
        }

        .tp-meta {
            font-size: 0.8rem;
        }

        .tp-actions {
            margin-top: 12px;
        }

        .tp-actions .btn-buy {
            flex: 1 0 100%;
            padding: 12px 10px;
            font-size: 0.94rem;
        }

        .tp-review {
            flex: 1 0 100%;
            text-align: center;
        }

        .article-content {
            font-size: 1rem;
        }

        .author-bio-card {
            flex-direction: column;
            text-align: center;
        }
    }
</style>
