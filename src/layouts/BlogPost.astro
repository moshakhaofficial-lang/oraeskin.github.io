---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AffiliateDisclaimer from '../components/AffiliateDisclaimer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';

const { frontmatter } = Astro.props;
const siteUrl = 'https://www.oraeskin.in';
const currentUrl = `${siteUrl}${Astro.url.pathname}`;
const articleImage = frontmatter.image?.startsWith('http') 
    ? frontmatter.image 
    : `${siteUrl}${frontmatter.image || '/images/Oraeskin_FBCover.png'}`;
---

<Layout title={`${frontmatter.title} | OraeSkin Reviews`}>
    <!-- SEO Meta Tags -->
    <meta name="description" content={frontmatter.description} slot="head" />
    <meta name="keywords" content={frontmatter.keywords || "skincare reviews, amazon india skincare, best skincare products, indian skin routines, OraeSkin"} slot="head" />
    <link rel="canonical" href={currentUrl} slot="head" />
    
    <!-- Open Graph -->
    <meta property="og:title" content={frontmatter.title} slot="head" />
    <meta property="og:description" content={frontmatter.description} slot="head" />
    <meta property="og:image" content={articleImage} slot="head" />
    <meta property="og:type" content="article" slot="head" />
    <meta property="og:url" content={currentUrl} slot="head" />
    <meta property="og:site_name" content="OraeSkin" slot="head" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" slot="head" />
    <meta name="twitter:title" content={frontmatter.title} slot="head" />
    <meta name="twitter:description" content={frontmatter.description} slot="head" />
    <meta name="twitter:image" content={articleImage} slot="head" />
    
    <!-- Structured Data (JSON-LD) -->
    <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": frontmatter.title,
        "image": [articleImage],
        "datePublished": frontmatter.date || "2026-01-01",
        "dateModified": frontmatter.date || "2026-03-01",
        "author": {
            "@type": "Organization",
            "name": "OraeSkin Editorial Team",
            "url": siteUrl
        },
        "publisher": {
            "@type": "Organization",
            "name": "OraeSkin",
            "logo": {
                "@type": "ImageObject",
                "url": `${siteUrl}/images/logo_opt.png`
            }
        },
        "description": frontmatter.description,
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": currentUrl
        }
    })} />
    
    <Header />
    <main class="blog-article-main">
        <article class="container blog-container">
            <header class="article-header">
                {frontmatter.category && (
                    <span class="category-pill">{frontmatter.category}</span>
                )}
                <h1 class="article-title">{frontmatter.title}</h1>
                
                <div class="article-meta">
                    <span class="author-label">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
                        </svg>
                        OraeSkin Editorial Team
                    </span>
                    <span class="meta-sep">•</span>
                    <span class="date-label">Updated {frontmatter.date || "2026"}</span>
                    <span class="meta-sep">•</span>
                    <span class="read-time">5 Min Read</span>
                </div>

                <AffiliateDisclaimer compact={true} />

                {frontmatter.image && (
                    <div class="hero-image-wrapper">
                        <img src={frontmatter.image} alt={frontmatter.title} class="article-hero-img" />
                    </div>
                )}
            </header>

            <div class="article-content">
                <slot />
            </div>

            <footer class="article-bottom-bar">
                <div class="author-bio-card">
                    <div class="bio-avatar">
                        <img src="/images/favicon-logo.png" alt="OraeSkin Editorial" width="48" height="48" />
                    </div>
                    <div class="bio-text">
                        <h4>OraeSkin Editorial Team</h4>
                        <p>We research, analyze ingredient formulations, and curate top skincare products available on Amazon India to help you find evidence-informed skincare.</p>
                    </div>
                </div>

                <div class="article-nav-actions">
                    <a href="/blog" class="btn-back">← Back to All Guides & Reviews</a>
                    <a href="/#top-picks" class="btn-top-picks">Explore Top Amazon Deals →</a>
                </div>
            </footer>
        </article>
    </main>
    <MobileStickyBar 
        title={frontmatter.topPickTitle || "Minimalist SPF 50 Multi-Vitamin Sunscreen"}
        brand={frontmatter.topPickBrand || "Minimalist"}
        asinOrUrl={frontmatter.topPickAsin || "B09FPS9D5T"}
        rating={frontmatter.topPickRating || "4.8 ★"}
        priceEst={frontmatter.topPickPrice || "~₹399"}
    />
    <Footer />
</Layout>

<style>
    .blog-article-main {
        padding-top: 105px;
        padding-bottom: 60px;
        background: #fdfaf6;
    }

    .blog-container {
        max-width: 840px;
        margin: 0 auto;
        background: #ffffff;
        padding: 36px 40px;
        border-radius: 16px;
        border: 1px solid #ede5da;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
    }

    .article-header {
        margin-bottom: 36px;
    }

    .category-pill {
        display: inline-block;
        background: #f5ede4;
        color: #c87a54;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 4px 12px;
        border-radius: 14px;
        margin-bottom: 14px;
    }

    .article-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.4rem;
        line-height: 1.25;
        color: #2c2c2c;
        margin: 0 0 16px 0;
    }

    .article-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #777;
        font-size: 0.88rem;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .author-label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #555;
        font-weight: 500;
    }

    .meta-sep {
        color: #ccc;
    }

    .hero-image-wrapper {
        margin-top: 24px;
        border-radius: 12px;
        overflow: hidden;
        max-height: 420px;
    }

    .article-hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .article-content {
        font-size: 1.05rem;
        line-height: 1.7;
        color: #333333;
    }

    .article-content :global(h2) {
        font-family: 'Playfair Display', serif;
        font-size: 1.55rem;
        color: #2c2c2c;
        margin-top: 28px;
        margin-bottom: 12px;
        border-bottom: 1px solid #f0eae1;
        padding-bottom: 6px;
    }

    .article-content :global(h3) {
        font-family: 'Playfair Display', serif;
        font-size: 1.25rem;
        color: #3a3a3a;
        margin-top: 20px;
        margin-bottom: 10px;
    }

    .article-content :global(p) {
        margin-bottom: 14px;
    }

    .article-content :global(ul), .article-content :global(ol) {
        margin-bottom: 18px;
        padding-left: 24px;
    }

    .article-content :global(li) {
        margin-bottom: 8px;
    }

    .article-content :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 28px 0;
        font-size: 0.95rem;
    }

    .article-content :global(th) {
        background: #faf6f0;
        padding: 12px 14px;
        text-align: left;
        border-bottom: 2px solid #e8dfd3;
        font-weight: 600;
        color: #4a3e36;
    }

    .article-content :global(td) {
        padding: 12px 14px;
        border-bottom: 1px solid #f0eae1;
    }

    .article-content :global(a) {
        color: #c87a54;
        font-weight: 600;
        text-decoration: underline;
    }

    .article-content :global(a:hover) {
        color: #a85d38;
    }

    .article-bottom-bar {
        margin-top: 60px;
        border-top: 1px solid #ede5da;
        padding-top: 40px;
    }

    .author-bio-card {
        display: flex;
        align-items: center;
        gap: 18px;
        background: #fdfaf6;
        padding: 24px;
        border-radius: 12px;
        border: 1px solid #f0eae1;
        margin-bottom: 36px;
    }

    .bio-avatar img {
        border-radius: 50%;
        background: #fff;
        padding: 4px;
        border: 1px solid #e8dfd3;
    }

    .bio-text h4 {
        margin: 0 0 6px 0;
        font-size: 1.05rem;
        color: #2c2c2c;
    }

    .bio-text p {
        margin: 0;
        font-size: 0.9rem;
        color: #666;
        line-height: 1.5;
    }

    .article-nav-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .btn-back {
        color: #555;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: color 0.2s ease;
    }

    .btn-back:hover {
        color: #c87a54;
    }

    .btn-top-picks {
        background: #c87a54;
        color: #fff !important;
        text-decoration: none;
        padding: 10px 22px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 0.92rem;
        transition: background 0.2s ease;
    }

    .btn-top-picks:hover {
        background: #a85d38;
    }

    @media (max-width: 768px) {
        .blog-container {
            padding: 24px 18px;
            border-radius: 0;
            border: none;
        }

        .article-title {
            font-size: 1.85rem;
        }

        .article-content {
            font-size: 1rem;
        }

        .author-bio-card {
            flex-direction: column;
            text-align: center;
        }
    }
</style>
